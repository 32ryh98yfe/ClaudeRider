{
  "name": "clauderider",
  "private": true,
  "version": "0.1.0",
  "description": "ClaudeRider \u2014 an unofficial, non-commercial fan kart racer inspired by KartRider: Drift, starring Clawd.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "gen": "node tools/gen-registries.mjs",
    "check:frozen": "node tools/check-frozen.mjs",
    "check:deps": "node tools/check-deps.mjs",
    "typecheck": "node tools/typecheck.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:physics": "vitest run --project sim -t physics",
    "bake": "node packages/trackc/src/cli.ts build all --validate",
    "bake:ghost": "node packages/trackc/src/cli.ts build all --validate --ghost",
    "dev": "node tools/dev.mjs",
    "build": "vite build apps/client",
    "start": "node apps/server/src/main.ts",
    "start:test": "node apps/server/src/main.ts --port 8787 --static apps/client/dist",
    "e2e": "playwright test",
    "size": "node tools/size.mjs",
    "verify": "pnpm gen && pnpm check:frozen && pnpm check:deps && pnpm typecheck && pnpm lint && pnpm test && pnpm bake && pnpm build && pnpm e2e"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@cr/content": "workspace:*",
    "@cr/net": "workspace:*",
    "@cr/room": "workspace:*",
    "@cr/sim": "workspace:*",
    "@cr/trackc": "workspace:*",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.20.4",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.2",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
