PROP kind=lamp_post at=(2.0,-0.2,9.6) yaw=90 scale=1
PROP kind=lamp_post at=(-28.0,-0.2,-9.6) yaw=270 scale=1
PROP kind=lamp_post at=(-8.0,-0.2,-9.6) yaw=270 scale=1
PROP kind=lamp_post at=(12.0,-0.2,-9.6) yaw=270 scale=1
PROP kind=ad_board_a at=(-30.0,-0.2,8.4) yaw=90 scale=1
PROP kind=ad_board_a at=(4.0,-0.2,8.4) yaw=90 scale=1
PROP kind=ad_board_b at=(-22.0,-0.2,8.4) yaw=90 scale=1
