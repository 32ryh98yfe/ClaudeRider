# Kraken Lighthouse — Coral Cove D3, both modes (3 x ~1400 m), late-afternoon cliffs. From the harbour the road climbs
# the cliffs and the R18 cliff S, spirals a full turn up around the striped lighthouse (a stacked 360-degree helix,
# +11 m), runs the open cliff edge (no wall on the seaward left: fall and you respawn), turns along the cannon-fort straight
# under cannonball fire, drops through the fort corner and the rampart S down the cove, and threads the sea cave where
# the kraken's tentacles sweep the road before the grotto S, the harbour return and the breakwater home.
# No baked terrain: open sea everywhere; cliffs and headlands are props.
@signature helix, hazard:swinger, hazard:geyser
TRACK kraken_lighthouse name="Kraken Lighthouse" theme=coral_cove diff=3 laps=3 topo=circuit
DEFAULTS w=14 surf=asphalt wall=barrier:1.0 shoulder=1 shoulderSurf=sand blend=16
START pos=(0,0,0) hdg=0
GRID rows=4 cols=2 pitch=7 stagger=3.5 d=3
S 89                                               @harbour_straight
C R24 90 L bank=6                                  @harbour_corner
S 47 dy=3                                          @cliffside_climb
WIGGLE R30 35/70/35 R dy=3 surf=stone              @cliff_s
S 30                                               @lighthouse_approach
HELIX R36 360 L dy=11 bank=8 wallOut=rock:1.2      @lighthouse_helix
S 47 wallL=none:0:ledgeKill shoulderL=0             @cliff_edge
WIGGLE R30 35/70/35 L wallL=barrier:1.0 shoulderL=1 @cliff_edge_s
S 20
C R30 90 L bank=6                                  @headland_corner
S ?c                                               @cannon_fort
C R16 90 L bank=6                                  @fort_corner
WIGGLE R30 40/80/40 R dy=-3                        @rampart_s
WIGGLE R120 10/20/10 R dy=-6                       @cove_descent
C R40 90 R bank=-5                                 @tide_pool_corner
S 47 surf=wet                                      @sea_cave
WIGGLE R60 15/30/15 R surf=asphalt dy=-4           @grotto_s
C R28 90 L bank=6                                  @cave_exit
S ?b dy=-2                                         @harbour_return
C R40 90 L bank=5 dy=-2                            @quay_corner
C R100 15 L ; C R100 15 R                          @breakwater
S ?a                                               @to_the_line
CLOSE solve=[?a,?b,?c] length=1400
LINE start at=0
ITEMS at=@harbour_straight+60,@lighthouse_approach+20,@cliff_edge+25,@cove_descent+70,@grotto_s+32 n=5
PAD at=@to_the_line+5 d=0 len=6 w=4
PAD at=@harbour_straight+2 d=0 len=6 w=4
KEYS @cliffside_climb+20,@lighthouse_approach+10,@cliff_edge+20,@cannon_fort+5,@cove_descent+40,@grotto_s+30,@harbour_return+10,@breakwater+20
# cannonballs from the fort: three staggered impact circles (launch), telegraphed 1 s ahead
HAZ geyser ball1 at=@cannon_fort+14 d=-3 r=2.6 period=4 on=0-0.35 tele=1.0 offset=0 prop=hazard_cannonball
HAZ geyser ball2 at=@cannon_fort+30 d=3 r=2.6 period=4 on=0-0.35 tele=1.0 offset=1.3 prop=hazard_cannonball
HAZ geyser ball3 at=@cannon_fort+46 d=-1 r=2.6 period=4 on=0-0.35 tele=1.0 offset=2.6 prop=hazard_cannonball
# the kraken: two tentacles sweeping across the sea-cave road out of phase
HAZ swinger tentacle1 at=@sea_cave+14 d=0 capsule=(0.9,2.5) arm=6 amp=55 plane=across period=5 offset=0 prop=hazard_tentacle
HAZ swinger tentacle2 at=@sea_cave+36 d=0 capsule=(0.9,2.5) arm=6 amp=55 plane=across period=5 offset=2.5 prop=hazard_tentacle
PROPS kind=sea along=main from=@harbour_straight+40 to=@harbour_straight+40 side=R every=100 offset=200 scale=1-1
# the harbour: quay pilings, cargo and boats, the breakwater
PROPS kind=beach along=main from=@quay_corner to=@to_the_line+72 side=L every=14 offset=0.3
PROPS kind=beach along=main from=@harbour_straight to=@harbour_corner side=L every=14 offset=0.3
PROPS kind=cargo along=main from=@harbour_straight+66 to=@harbour_straight+86 side=L every=18 offset=3
PROPS kind=market_stall along=main from=@to_the_line+10 to=@to_the_line+60 side=L every=16 offset=3
PROPS kind=boat along=main from=@quay_corner to=@harbour_corner side=R every=40 offset=18 jitter=30
PROPS kind=buoy along=main from=@quay_corner to=@to_the_line+72 side=R every=30 offset=12 jitter=25
# the cliffs: rock masses under both edges wherever the road stands above the sea
PROPS kind=cliff along=main from=@cliffside_climb to=@harbour_return side=both every=9 offset=0.3 scale=0.9-1.2
PROPS kind=palm along=main from=@cliffside_climb to=@lighthouse_approach side=both every=18 offset=3 jitter=5
# the lighthouse on its rock inside the helix
PROP kind=lighthouse at=(68.09,1.11,-169.58) yaw=-179.6 scale=1   # helix centre (s=277, u=-36)
# the cannon fort: guns along the ramparts (the cannonballs themselves are HAZ geysers)
PROPS kind=cannon along=main from=@cannon_fort to=@fort_corner side=both every=10 offset=1.5
PROPS kind=cannon along=main from=@rampart_s to=@cove_descent side=R every=16 offset=1.5
# the sea cave: the kraken rising around the cave road (its sweeping tentacles are HAZ swingers)
PROPS kind=kraken_tentacle along=main from=@tide_pool_corner+30 to=@grotto_s+20 side=both every=14 offset=6 jitter=4
# the far water: sea-level props only beside sea-level road (rows sit at road height); round the cliffs they are
# hand-placed at the sea (PROP lines below), so no sea stack hangs in the sky beside the raised road
PROPS kind=sea_stack along=main from=@quay_corner to=@harbour_corner+30 side=R every=90 offset=70 jitter=60
# ---- stylized dressing pass (2026-10, docs/design/34-stylized-pass.md; render-only, the .ctrk is unchanged) ----
# Land is the harbour beach (inside, L), the stone quay (outside, R: hand-placed segments, it replaces the pilings)
# and the cliff masses under the raised road (ground cover stays within their ~6 m top band).
# start straight: grandstand on the beach, crowd, flags and boards; harbour lamps and dock clutter on the quay
PROPS kind=grandstand along=main from=@harbour_straight+30 to=@harbour_straight+31 side=L every=100 offset=5.5 seed=60
PROPS kind=flag_pole along=main from=@harbour_straight+44 to=@harbour_straight+52 side=L every=4 offset=2.6 seed=61
PROPS kind=spectators along=main from=@harbour_straight+68 to=@harbour_straight+86 side=L every=9 offset=2.4 jitter=1 seed=62
PROPS kind=lamp_post along=main from=@harbour_straight+22 to=@harbour_corner+38 side=R every=20 offset=1.6 seed=63
PROPS kind=lamp_post along=main from=@harbour_straight+22 to=@harbour_straight+88 side=L every=20 offset=1.6 seed=64
PROPS kind=ad_board_a along=main from=@harbour_straight+16 to=@harbour_straight+86 side=R every=24 offset=0.4 seed=65
PROPS kind=ad_board_b along=main from=@harbour_straight+24 to=@harbour_straight+86 side=R every=24 offset=0.4 seed=66
PROPS kind=ad_board_c along=main from=@harbour_straight+32 to=@harbour_straight+86 side=R every=24 offset=0.4 seed=67
PROPS kind=crate_stack along=main from=@harbour_straight+18 to=@harbour_straight+86 side=R every=17 offset=4 jitter=1 seed=68
PROPS kind=beach_umbrella along=main from=@harbour_straight+50 to=@harbour_corner+30 side=L every=15 offset=10 jitter=4 seed=69
# the harbour corner (T1, outside R): tyre wall on the quay
PROPS kind=tyre_wall along=main from=@harbour_corner+2 to=@harbour_corner+37 side=R every=1.3 offset=0.6 seed=70
# ground cover, shrubs and palms on the beach and the cliff tops
PROPS kind=grass_tuft along=main from=@harbour_straight+14 to=@harbour_corner+38 side=L every=0.8 offset=0.2 jitter=8 scale=1.0-1.8 seed=71
PROPS kind=grass_tuft along=main from=@quay_corner to=@to_the_line side=L every=0.8 offset=0.2 jitter=8 scale=1.0-1.8 seed=72
PROPS kind=grass_tuft along=main from=@cliffside_climb to=@harbour_return side=both every=0.8 offset=0.2 jitter=3 scale=1.0-1.6 seed=73
PROPS kind=flower_patch along=main from=@harbour_straight+14 to=@harbour_corner+38 side=L every=5 offset=0.8 jitter=9 scale=0.8-1.3 seed=74
PROPS kind=flower_patch along=main from=@quay_corner to=@to_the_line side=L every=5 offset=0.8 jitter=9 scale=0.8-1.3 seed=75
PROPS kind=flower_patch along=main from=@cliffside_climb to=@harbour_return side=both every=6 offset=0.8 jitter=3 scale=0.8-1.2 seed=76
PROPS kind=bush_round along=main from=@harbour_straight+14 to=@harbour_corner+38 side=L every=11 offset=3 jitter=9 scale=0.7-1.3 seed=77
PROPS kind=bush_round along=main from=@quay_corner to=@to_the_line side=L every=11 offset=3 jitter=9 scale=0.7-1.3 seed=78
PROPS kind=bush_round along=main from=@cliffside_climb to=@harbour_return side=both every=12 offset=2.5 jitter=3 scale=0.7-1.2 seed=79
PROPS kind=rock_cluster along=main from=@cliffside_climb to=@harbour_return side=both every=19 offset=3 jitter=4 scale=0.7-1.4 seed=80
PROPS kind=rock_cluster along=main from=@quay_corner to=@to_the_line side=L every=23 offset=4 jitter=12 scale=0.6-1.4 seed=81
PROPS kind=tree_round_big along=main from=@harbour_straight+56 to=@harbour_corner+38 side=L every=17 offset=14 jitter=8 scale=0.8-1.2 seed=82
PROPS kind=tree_round_big along=main from=@quay_corner to=@to_the_line-20 side=L every=17 offset=14 jitter=8 scale=0.8-1.2 seed=83
PROPS kind=tree_round_big along=main from=@cannon_fort to=@harbour_return side=R every=30 offset=6 jitter=2 scale=0.8-1.1 seed=84
PROPS kind=tree_round_big along=main from=@cliffside_climb to=@lighthouse_approach side=R every=26 offset=6 jitter=2 scale=0.8-1.1 seed=85
PROPS kind=lamp_post along=main from=@cliff_edge_s to=@harbour_return side=R every=40 offset=1.4 seed=86
PROPS kind=lamp_post along=main from=@quay_corner to=@to_the_line side=both every=24 offset=1.6 seed=87
PROPS kind=seagull along=main side=both every=70 offset=18 jitter=30 seed=88
# the start zone (line ±10 m and the pads at 2 / 1332 exclude PROPS rows from 1326 to 14) and the quay segments:
# hand-placed from the baked frame (offset from the road edge)
PROP kind=quay at=(-110.4,-0.2,13.9) yaw=97 scale=1
PROP kind=quay at=(-97.7,-0.2,11.5) yaw=104 scale=1
PROP kind=quay at=(-86.7,-0.2,9.1) yaw=99 scale=1
PROP kind=quay at=(-75.7,-0.2,8.1) yaw=92 scale=1
PROP kind=quay at=(-64.0,-0.2,8.0) yaw=90 scale=1
PROP kind=quay at=(-52.0,-0.2,8.0) yaw=90 scale=1
PROP kind=quay at=(-40.0,-0.2,8.0) yaw=90 scale=1
PROP kind=quay at=(-28.0,-0.2,8.0) yaw=90 scale=1
PROP kind=quay at=(-16.0,-0.2,8.0) yaw=90 scale=1
PROP kind=quay at=(-4.0,-0.2,8.0) yaw=90 scale=1
PROP kind=quay at=(8.0,-0.2,8.0) yaw=90 scale=1
PROP kind=quay at=(20.0,-0.2,8.0) yaw=90 scale=1
