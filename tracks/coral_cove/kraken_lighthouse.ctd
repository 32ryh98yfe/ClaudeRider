PROP kind=quay at=(121.0,0.4,-23.0) yaw=178 scale=1
PROP kind=grass_patch at=(-36.0,-0.2,-8.2) yaw=270 scale=1
PROP kind=grass_patch at=(-24.0,-0.2,-8.2) yaw=270 scale=1
PROP kind=grass_patch at=(-12.0,-0.2,-8.2) yaw=270 scale=1
PROP kind=grass_patch at=(-0.0,-0.2,-8.2) yaw=270 scale=1
