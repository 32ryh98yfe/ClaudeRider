# the far water at sea level: sea stacks, palm islets and sailboats round the cliffs
PROP kind=sea_stack at=(181.0,-0.2,-47.3) yaw=180 scale=1
PROP kind=sea_stack at=(204.3,-0.2,-154.4) yaw=-167 scale=1
