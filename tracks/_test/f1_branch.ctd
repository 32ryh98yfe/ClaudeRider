# F1 fixture (L4): shortcut branch with split/merge gores, boost + jump pads, per-segment and per-zone surfaces,
# conveyors, noItem zone, PROPS rows. Rectangle circuit, 4 × R40 corners; the branch cuts the second corner.
TRACK f1_branch name="F1 Branch Fixture" theme=spark_circuit diff=2 laps=3 topo=circuit
DEFAULTS w=16 surf=asphalt wall=barrier:1.0 shoulders=2:grass blend=15
START pos=(0,0,0) hdg=0
GRID rows=4 cols=2 pitch=6 stagger=3 d=4
S ?a                          @home
C R40 90 L                    @t1
S 150                         @back
C R40 90 L                    @t2
S ?a surf=cobble              @far
C R40 90 L                    @t3
S 150 shoulders=3:sand        @west
C R40 90 L                    @t4
CLOSE solve=[?a] length=1200
LINE start at=@home+100

# the shortcut: leaves the back straight 60 m in, rejoins the far straight 110 m in
BRANCH cut from=@back+60 to=@far+110 kind=shortcut aiMin=0.3 w=9 wall=fence:1.2 surf=dirt {
  C R25 45 L ; S ?x ; C R25 45 L ; S ?y
}

PAD at=@home+150,@home+200 d=0 len=6 w=4
PAD at=@west+40 d=0 len=5 w=4 kind=jump
PAD at=40 d=0 len=6 w=3 path=cut
ZONE conveyor from=@far+180 to=@far+260 d=[0,8] mul=1.15
ZONE conveyor from=@far+180 to=@far+260 d=[-8,0] mul=0.85
ZONE surface from=@t3 to=@t3+40 d=[-8,-3] surf=sand
ZONE noItem from=@west to=@west+60
ITEMS at=@home+260,@back+20,@far+40,@far+300,@west+100 n=5
KEYS @home+230,@t1+30,@far+140,@far+230,@t3+30,@west+100,@t4+30
PROPS kind=cone along=main side=both every=20 offset=2
PROPS kind=bush along=cut side=both every=12 offset=1.5 jitter=1 seed=7
THEME scatter=tree_round,bush density=4 hills=4 sky=day
