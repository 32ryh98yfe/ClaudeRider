# Spark Grand Circuit — Spark Circuit D1, speed-built racing-line tutorial (3 x ~1500 m).
# A pro GP layout: the 390 m pit/start straight, a left Turn 1, climbing esses up the east side, the R30 hairpin with a
# huge gravel run-off, the back straight down past the stadium, a west-bound run of kinks and the sponsor S, then the
# tower and final corners onto the straight. Everything is wide (17 m) and forgiving; rideable kerbs on every corner.
@signature branch, pads
TRACK spark_grand_circuit name="Spark Grand Circuit" theme=spark_circuit diff=1 laps=3 topo=circuit
DEFAULTS w=17 surf=asphalt wall=barrier:1.0 shoulder=3 shoulderSurf=grass blend=16
START pos=(0,0,0) hdg=0
GRID rows=4 cols=2 pitch=7 stagger=3.5 d=4
S 258 w=19                                        @pit_straight
C R40 90 L bank=6 w=17                            @turn1
S 64                                              @grandstand_run
WIGGLE R60 40/80/40 R dy=2 bank=4                 @esses
S ?b                                              @esses_exit
C R30 180 L bank=5 shoulder=9 shoulderSurf=gravel @hairpin
S 129 dy=-2 shoulder=3 shoulderSurf=grass         @back_straight
C R50 90 R bank=-6                                @stadium_corner
C R80 40 R ; C R80 40 L                           @kinks
WIGGLE R55 35/70/35 R bank=4                      @sponsor_s
S ?c                                              @sponsor_straight
C R45 90 L bank=6                                 @tower_corner
S 60                                              @tower_run
C R45 90 L bank=6                                 @final_corner
S ?a w=19                                         @to_the_line
CLOSE solve=[?a,?b,?c] length=1500
LINE start at=0
# the pit lane: an alternative line alongside the pit straight (9 m, its own two pads), behind the pit wall
BRANCH pit_lane from=@pit_straight+14 to=@pit_straight+236 kind=alt aiMin=0.2 w=9 wall=barrier:1.0 shoulder=0 {
  C R25 30 L ; S ?x ; C R25 30 R ; S ?y ; C R25 30 R ; S 30 ; C R25 30 L
}
PAD at=66 d=-2.2 len=6 w=4 path=pit_lane
PAD at=66 d=2.2 len=6 w=4 path=pit_lane
ITEMS at=80,350,572,760,950,1165 n=5
PAD at=60,130 d=0 len=6 w=4
KEYS 250,450,700,900,1100,1300
# segment map (s from the line): pit 0-258 | T1 258-321 | run 321-385 | esses 385-553 | exit 553-586 | hairpin 586-680
#   back 680-809 | stadium 809-888 | kinks 888-1000 | sponsor S 1000-1134 | sponsor straight 1134-1196 | tower 1196-1266
#   tower run 1266-1326 | final 1326-1397 | to the line 1397-1500
# pit row (fallback for the pit-lane branch): pit wall, garages and race control on the infield side
PROPS kind=pit_wall along=36-214 side=L every=20 offset=2.3
PROPS kind=pit_garage along=pit_lane side=L every=21 offset=1.5 from=40 to=190
PROPS kind=pit_wall along=1405-1495 side=L every=20 offset=3
PROPS kind=pit_garage along=1407-1492 side=L every=21 offset=13
PROPS kind=control_tower along=252-252 side=L every=10 offset=16
# main grandstands opposite the pits, around the line
PROPS kind=grandstand along=90-175 side=R every=27 offset=6
PROPS kind=grandstand along=1402-1490 side=R every=27 offset=6
PROPS kind=floodlight along=10-250 side=R every=54 offset=20
# Turn 1 and the esses
PROPS kind=tyre_wall along=256-326 side=R every=4 offset=1.2
PROPS kind=marshal_post along=334-334 side=R every=10 offset=4
PROPS kind=banner along=326-382 side=both every=11 offset=1.4
PROPS kind=banner along=390-550 side=both every=12 offset=1.4
PROPS kind=grandstand along=440-510 side=L every=35 offset=10
# the hairpin: gravel run-off, tyre wall, a stand and a TV camera
PROPS kind=tyre_wall along=584-684 side=R every=5 offset=9
PROP kind=grandstand at=(265.70,1.65,-349.41) yaw=-87.7 scale=1   # hairpin stand (a row this far out on the banked high side is dropped), s=634
PROPS kind=camera_tower along=634-634 side=R every=10 offset=30
# back straight: the overhead chevron bridge, boards
# landmarks over the road are hand-placed (PROPS rows never land on a drivable surface); regenerate if the layout moves
PROP kind=footbridge at=(238.00,0.79,-226.50) yaw=0.0 scale=1   # back straight, s=745
PROPS kind=banner along=690-800 side=both every=14 offset=1.4
# stadium corner (right-hander: outside on the left)
PROPS kind=stadium along=814-884 side=L every=33 offset=7
PROPS kind=tyre_wall along=806-892 side=L every=4 offset=1.2
PROPS kind=floodlight along=820-880 side=L every=30 offset=42
PROPS kind=marshal_post along=940-940 side=L every=10 offset=4
# kinks: tree belts both sides, boards on the apexes, a stand on the outside of the second kink
PROPS kind=banner along=890-1000 side=both every=13 offset=1.4
PROPS kind=tree_round along=880-1130 side=R every=16 offset=16 jitter=18
PROPS kind=pine along=880-1130 side=L every=15 offset=14 jitter=16
PROPS kind=grandstand along=955-990 side=R every=30 offset=8
# sponsor S and straight
PROPS kind=banner along=1002-1192 side=both every=11 offset=1.4
PROPS kind=grandstand along=1140-1190 side=R every=30 offset=8
# tower and final corners
PROPS kind=tyre_wall along=1194-1270 side=R every=4 offset=1.2
PROPS kind=camera_tower along=1232-1232 side=R every=10 offset=10
PROPS kind=floodlight along=1270-1326 side=both every=28 offset=12
PROPS kind=banner along=1268-1326 side=both every=12 offset=1.4
PROPS kind=pine along=1190-1400 side=R every=14 offset=24 jitter=18
PROPS kind=tree_round along=1250-1340 side=L every=18 offset=14 jitter=10
PROPS kind=tyre_wall along=1324-1400 side=R every=4 offset=1.2
PROPS kind=marshal_post along=1362-1362 side=R every=10 offset=5
# ---- stylized dressing pass (2026-10, docs/design/34-stylized-pass.md; render-only, the .ctrk is unchanged) ----------
# start straight: flags and a cheering crowd between the main stand and Turn 1, lamps along the stand side
PROPS kind=flag_pole along=180-250 side=R every=6 offset=2.6 seed=60
PROPS kind=spectators along=12-84 side=R every=18 offset=2.4 jitter=1 seed=61
PROPS kind=spectators along=184-248 side=R every=22 offset=3.4 jitter=1 seed=62
PROPS kind=lamp_post along=1400-250 side=R every=24 offset=1.8 seed=63
# chevron boards above the tyre walls on the outside of the left-handers (Turn 1, tower, final; never on a right-hander's
# left-side outside, where a +Z chevron would point the wrong way); 3.6 m out so the posts stand behind the tyre stacks
PROPS kind=ad_board_b along=260-318 side=R every=10 offset=3.6 seed=64
PROPS kind=ad_board_b along=1198-1262 side=R every=10 offset=3.6 seed=65
PROPS kind=ad_board_b along=1328-1394 side=R every=10 offset=3.6 seed=66
PROPS kind=spectators along=596-672 side=R every=19 offset=12 jitter=2 seed=67
# ground cover at the barrier foot round the lap (the pit row on the left of the pit straight stays concrete)
PROPS kind=grass_tuft side=R every=1.1 offset=0.2 jitter=7 scale=1.0-1.7 seed=41
PROPS kind=grass_tuft along=252-6 side=L every=1.1 offset=0.2 jitter=7 scale=1.0-1.7 seed=42
PROPS kind=flower_patch side=R every=7 offset=0.8 jitter=9 scale=0.8-1.3 seed=43
PROPS kind=flower_patch along=252-6 side=L every=7 offset=0.8 jitter=9 scale=0.8-1.3 seed=44
# shrubs skip the tyre-wall spans (R 256-326, 1194-1270, 1324-1400; L 806-892): they grew through the stacks
PROPS kind=bush_round along=1404-252 side=R every=12 offset=3 jitter=2 scale=0.7-1.3 seed=45
PROPS kind=bush_round along=330-1190 side=R every=12 offset=3 jitter=2 scale=0.7-1.3 seed=70
PROPS kind=bush_round along=1274-1320 side=R every=12 offset=3 jitter=2 scale=0.7-1.3 seed=71
PROPS kind=bush_round along=252-802 side=L every=12 offset=3 jitter=2 scale=0.7-1.3 seed=46
PROPS kind=bush_round along=896-6 side=L every=12 offset=3 jitter=2 scale=0.7-1.3 seed=72
PROPS kind=rock_cluster along=252-1400 side=both every=30 offset=4 jitter=6 scale=0.6-1.3 seed=47
# shade trees (none behind the grandstands, the stadium or the pit row), far tree lines
PROPS kind=tree_round_big along=180-950 side=R every=20 offset=16 jitter=14 scale=0.8-1.3 seed=48
PROPS kind=tree_round_big along=995-1135 side=R every=20 offset=16 jitter=14 scale=0.8-1.3 seed=49
PROPS kind=tree_round_big along=1195-1395 side=R every=20 offset=30 jitter=14 scale=0.8-1.3 seed=50
PROPS kind=tree_round_big along=262-435 side=L every=20 offset=16 jitter=14 scale=0.8-1.3 seed=51
PROPS kind=tree_round_big along=515-580 side=L every=20 offset=16 jitter=14 scale=0.8-1.3 seed=52
PROPS kind=tree_round_big along=690-805 side=L every=20 offset=16 jitter=14 scale=0.8-1.3 seed=56
PROPS kind=tree_round_big along=890-1395 side=L every=20 offset=24 jitter=14 scale=0.8-1.3 seed=53
# far tree lines only where they stay >= 30 m from every other part of the track (a clump 60-175 m out from one
# segment otherwise lands beside, or on the edge of, another; ranges from a fold check of the baked centrelines)
PROPS kind=tree_clump along=1025-1070 side=L every=26 offset=60 jitter=50 scale=0.9-1.4 seed=54
PROPS kind=tree_clump along=1230-1365 side=L every=26 offset=60 jitter=50 scale=0.9-1.4 seed=54
PROPS kind=tree_clump along=0-780 side=R every=26 offset=60 jitter=50 scale=0.9-1.4 seed=54
PROPS kind=tree_clump along=830-900 side=R every=26 offset=60 jitter=50 scale=0.9-1.4 seed=54
PROPS kind=tree_clump along=955-1500 side=R every=26 offset=60 jitter=50 scale=0.9-1.4 seed=54
PROPS kind=tree_clump along=535-610 side=L every=34 offset=125 jitter=50 scale=1.0-1.6 seed=55
PROPS kind=tree_clump along=665-840 side=L every=34 offset=125 jitter=50 scale=1.0-1.6 seed=55
PROPS kind=tree_clump along=1250-1320 side=L every=34 offset=125 jitter=50 scale=1.0-1.6 seed=55
PROPS kind=tree_clump along=0-760 side=R every=34 offset=125 jitter=50 scale=1.0-1.6 seed=55
PROPS kind=tree_clump along=825-890 side=R every=34 offset=125 jitter=50 scale=1.0-1.6 seed=55
PROPS kind=tree_clump along=970-1500 side=R every=34 offset=125 jitter=50 scale=1.0-1.6 seed=55
PROP kind=hot_air_balloon at=(120.0,50.0,-180.0) yaw=0 scale=1
PROP kind=hot_air_balloon at=(340.0,58.0,-300.0) yaw=40 scale=1.2
PROP kind=hot_air_balloon at=(-70.0,46.0,-110.0) yaw=10 scale=0.9
# field scatter is low cover only: the random 8–78 m scatter put big trees in front of the grandstands and over the grid;
# the tree belts and tree lines come from the PROPS rows above, which keep the stands, pits and grid clear
THEME scatter=bush_round,bush_round,bush,rock_cluster,flower_patch,flower_patch,grass_tuft,grass_tuft density=36 hills=5 sky=day time=13:00 fogNear=250 fogFar=1500
