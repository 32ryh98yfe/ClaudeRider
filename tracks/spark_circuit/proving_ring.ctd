# Proving Ring — off-roster tutorial / CI oval (5 x ~700 m). Wide, flat, forgiving.
TRACK proving_ring name="Proving Ring" theme=spark_circuit diff=1 laps=5 topo=circuit
DEFAULTS w=18 surf=asphalt wall=barrier:1.0 shoulder=2 shoulderSurf=grass blend=15
START pos=(0,0,0) hdg=0
GRID rows=4 cols=2 pitch=7 stagger=3.5 d=4
S ?a                      @home
C R40 180 L bank=6        @turn1
S ?a                      @back
C R40 180 L bank=6        @turn2
CLOSE solve=[?a] length=700
LINE start at=120
ITEMS at=40,220(n=6),390,560 n=5
PAD at=60,410 d=0 len=6 w=4
# dressing (s from the line): main straight 580-700 + 0-104 | turn 1 104-230 | back straight 230-454 | turn 2 454-580
PROPS kind=grandstand along=590-690 side=R every=27 offset=6
PROPS kind=grandstand along=8-92 side=R every=27 offset=6
PROPS kind=pit_wall along=584-696 side=L every=20 offset=3
PROPS kind=pit_garage along=586-694 side=L every=21 offset=12
PROPS kind=control_tower along=40-40 side=L every=10 offset=14
PROPS kind=tyre_wall along=100-234 side=R every=5 offset=1.2
PROPS kind=tyre_wall along=450-584 side=R every=5 offset=1.2
PROPS kind=banner along=236-450 side=both every=12 offset=1.4
PROPS kind=floodlight along=240-450 side=R every=52 offset=16
PROPS kind=marshal_post along=168-168 side=R every=10 offset=4
PROPS kind=marshal_post along=518-518 side=R every=10 offset=4
PROPS kind=camera_tower along=342-342 side=L every=10 offset=12
PROPS kind=footbridge along=300-300 side=R every=10 offset=-11
PROPS kind=pine along=236-450 side=R every=16 offset=30 jitter=20
# ---- stylized dressing pass (2026-10, docs/design/34-stylized-pass.md; render-only, the .ctrk is unchanged) ----------
# Proving Ring is the e2e track (Low tier on SwiftShader), so it gets a moderate, plants-only layer (≤ 1500 props in
# all): TrackView thins every grass/flower/bush/tree kind by the tier's foliage factor and culls it early.
# infield (left) round the lap except the pit row; outside (right) of both turns and the back straight
PROPS kind=grass_tuft along=0-584 side=L every=1.6 offset=0.2 jitter=6 scale=1.0-1.7 seed=41
PROPS kind=grass_tuft along=100-590 side=R every=1.6 offset=0.2 jitter=6 scale=1.0-1.7 seed=42
PROPS kind=flower_patch along=0-584 side=L every=9 offset=0.8 jitter=8 scale=0.8-1.3 seed=43
PROPS kind=flower_patch along=100-590 side=R every=9 offset=0.8 jitter=8 scale=0.8-1.3 seed=44
PROPS kind=bush_round along=0-584 side=L every=14 offset=3 jitter=8 scale=0.7-1.3 seed=45
PROPS kind=bush_round along=236-450 side=R every=14 offset=3.5 jitter=6 scale=0.7-1.3 seed=46
# infield shade trees, an outer tree belt and far tree lines (none behind the grandstands or the grid)
PROPS kind=tree_round_big along=110-570 side=L every=18 offset=14 jitter=12 scale=0.8-1.3 seed=47
PROPS kind=tree_round_big along=240-450 side=R every=18 offset=18 jitter=10 scale=0.8-1.3 seed=48
PROPS kind=tree_clump along=100-590 side=R every=30 offset=60 jitter=40 scale=0.9-1.4 seed=49
PROPS kind=tree_clump side=R every=40 offset=120 jitter=50 scale=1.0-1.6 seed=50
THEME scatter=tree_round,tree_round_big,bush,bush_round,pine,tree_clump density=12 hills=4 sky=day fogNear=250 fogFar=1500
