# Sunstone Bazaar / 선스톤 바자르 — Sunstone Desert, D1, 3 × 1450 m, item★ (11-track-spec §12.3).
# 16:00 heat haze over a caravan town: the awning market street, the oasis-pond corner, palm S-bends, the dune
# hump, the camel-statue corner, the caravan road, the well-plaza sweeper, the rug market and the gate chicane.
# Sand shoulders on the oasis and dune sections teach the off-road slowdown (sand 0.85 grip / ×0.92).
@signature branch, surfaces, jump, hazard:traffic
TRACK sunstone_bazaar name="Sunstone Bazaar" theme=sunstone_desert diff=1 laps=3 topo=circuit
DEFAULTS w=18 surf=stone wall=building:2.5 shoulder=1 shoulderSurf=sand blend=16
START pos=(0,0,0) hdg=0
GRID rows=4 cols=2 pitch=7 stagger=3.5 d=4
S 199                                     @market_street # awning market street; pads +90/+140
C R35 90 L bank=6 w=19 shoulder=3 wall=rock:1.0 @oasis   # oasis-pond corner, sand both sides (V19)
S 63 w=18 shoulder=2                      @palms
WIGGLE R50 30/65/30 R bank=3              @palm_s
C R80 25 L                                @dune_approach
S 30 dy=2 shoulder=3                      @dune_climb
J ramp=10@8 gap=10 drop=3 land=45 wland=20 vmin=22 vmax=46 @dune  # wide dune jump, generous landing
S ?b=59 w=18                              @dune_top      # item row; the awning lane splits here
C R45 80 L bank=6 w=18                    @camel         # camel-statue corner (V19)
S ?c=155 dy=1 shoulder=1.5 wall=building:2.5 @caravan
C R60 60 R bank=-4
C R40 120 L bank=8 w=20 shoulder=3        @well_plaza    # well-plaza sweeper (V19)
S 20 w=19
WIGGLE R55 30/65/40 L bank=3 w=18 shoulder=1 @rug_s
S 101                                     @rug_market
C R55 80 L bank=5                         @lantern
C R70 25 R ; C R70 40 L                   @gate_chicane
S ?a=98                                   @run_in
CLOSE solve=[?a,?b,?c] length=1450
LINE start at=0
ITEMS at=170,443,790,1120,1300 n=5
PAD at=40,100 d=0 len=6 w=4
KEYS 230,480,800,1000,1150,1380
# pot-cart traffic trundling down the rug market's left lane; the right two thirds of the street stay clear
HAZ traffic carts at=@rug_market+32 to=@rug_market+98 lanes=[(d -5, speed 7, count 2, spacing 33)] prop=hazard_pot_cart
# sand on the inside of the oasis corner (the pond side)
ZONE surface from=@oasis to=@oasis+55 d=[-12.5,-5] surf=sand
# the awning shortcut: a caravanserai lane under market awnings, cutting inside the camel-statue corner
BRANCH awning from=@dune_top+9 to=@caravan+80 kind=shortcut aiMin=0.2 w=9 wall=building:3 surf=cobble {
  C R25 40 L ; S ?x ; C R25 40 L ; S ?y
}

# ---- look & dressing (Sunstone Desert kit; art bible: 16:00 over the caravan town) ----
# 2026-10 stylized pass (docs/design/34-stylized-pass.md, render-only: the .ctrk is unchanged): blue gradient sky and a
# neutral grade instead of the orange haze; a continuous two-storey street frontage (three house looks with striped
# awnings over the wall tops) along every walled stretch, a domed skyline behind it, cheering crowds on the start
# straight's roofs and bunting across the street; the open stretch from the oasis to the camel corner gets dry tufts,
# pebbles, desert blooms, scrub, small cacti, boulders, palms, acacias, saguaros, palm groves and dunes, and a roadside
# caravan market. Wide props are fitted so no footprint reaches into any road band (scratch fitrows).
THEME sunstone_desert sky=day time=16:00 scatter=tree_palm,tree_palm,tree_saguaro,bush_cactus,bush_round,bush_round,rock_cluster,tree_round_big,rock_pebbles,grass_tuft density=30 hills=8 fogNear=260 fogFar=1500
PROPS kind=reeds from=205 to=250 side=L every=6 offset=1 jitter=2 seed=44
PROPS kind=clay_pots from=560 to=612 side=R every=12 offset=5 seed=48
# the awning shortcut: the same frontage along the caravanserai lane (its 3 m walls meet the awning lips; fitted)
PROPS kind=bazaar_house_b along=awning from=23 to=23 side=L every=21 offset=3 seed=861
PROPS kind=bazaar_house_b along=awning from=44 to=107 side=L every=21 offset=0.5 seed=862
PROPS kind=bazaar_house_b along=awning from=44 to=86 side=R every=21 offset=0.5 seed=863
PROPS kind=bazaar_house_c along=awning from=30 to=114 side=L every=21 offset=0.5 seed=870
PROPS kind=bazaar_house_c along=awning from=51 to=93 side=R every=21 offset=0.5 seed=871
PROPS kind=bazaar_house_a along=awning from=37 to=100 side=L every=21 offset=0.5 seed=880
PROPS kind=bazaar_house_a along=awning from=58 to=79 side=R every=21 offset=0.5 seed=881
# the start straight's grandstand: crowds on the roof terraces of the b-houses, both sides
PROPS kind=spectators_roof from=11 to=179 side=both every=21 offset=1.5 seed=841
# oasis corner (T1, a left-hander): chevron boards above the 1 m rock wall on the outside
PROPS kind=ad_board_b from=203 to=250 side=R every=10 offset=2.4 seed=842
PROPS kind=ad_board_a from=262 to=420 side=R every=48 offset=0.6 seed=843
PROPS kind=ad_board_c from=286 to=420 side=L every=48 offset=0.6 seed=844
# open desert (oasis → camel corner): ground cover at the wall, scrub and boulders behind it
PROPS kind=grass_tuft from=200 to=678 side=both every=1 offset=0.3 jitter=9 scale=0.9-1.6 seed=851
PROPS kind=grass_tuft from=200.5 to=678 side=both every=2 offset=2 jitter=14 scale=0.8-1.4 seed=857
PROPS kind=rock_pebbles from=200 to=678 side=both every=6 offset=0.6 jitter=5 scale=0.8-1.4 seed=852
PROPS kind=flower_patch from=200 to=678 side=both every=9 offset=1 jitter=9 scale=0.8-1.3 seed=853
PROPS kind=bush_round from=200 to=678 side=both every=11 offset=3 jitter=9 scale=0.7-1.3 seed=854
PROPS kind=bush_cactus from=200 to=678 side=both every=15 offset=2.5 jitter=10 scale=0.8-1.3 seed=855
PROPS kind=rock_cluster from=200 to=678 side=both every=21 offset=4 jitter=12 scale=0.6-1.5 seed=856
