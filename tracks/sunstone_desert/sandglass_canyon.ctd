# Sandglass Canyon / 모래시계 협곡 — Sunstone Desert, D4, 2 × 1950 m, speed★ (11-track-spec §12.4).
# Harsh noon on the rim, warm bounce light below: drop into the slot canyon (−12 m), two tight S-chains under the
# sandfalls, the rope-bridge S, the R12 obelisk hairpin, a three-hairpin switchback climb back to the rim, the
# canyon-mouth drop, the mesa S, the U-turn and mesa sweeper, the sand flats, the dune S and the obelisk gate home.
# Layout re-balanced for a planar exact closure (the block-out folds back on itself): the switchback runs L-R-L,
# the U-turn is a right-hander paired with the left mesa sweeper; every named section keeps its radius.
# Grades are spread over the S-chains and hairpins so no stretch exceeds the D4 12% cap.
@signature warp, jump, surfaces
TRACK sandglass_canyon name="Sandglass Canyon" theme=sunstone_desert diff=4 laps=2 topo=circuit
DEFAULTS w=13 surf=stone wall=rock:1.4 shoulder=0.5 shoulderSurf=sand blend=16
START pos=(0,0,0) hdg=0
GRID rows=4 cols=2 pitch=7 stagger=3.5 d=3.5
S 91.5 w=14 wall=parapet:1.0              @rim_start     # rim start straight; pads +35/+70
C R30 90 R bank=-6 w=13 dy=-1 wall=rock:1.4 @drop_in     # rim drop-in (V19)
S 42.4 dy=-3                              @descent
C R40 60 L dy=-2 bank=4                   @descent_kink
WIGGLE R16 40/70/45 L dy=-3 w=16 shoulder=1 @sandfall_1 # sandfall S-chain 1 (V19 ×2)
WIGGLE R18 35/70/25 R dy=-2 w=16 wall=rock:1.4:soft @sandfall_2    # sandfall S-chain 2 (V19 ×2)
WIGGLE R30 30/55/20 L dy=-1 w=13 surf=wood shoulder=0.3 wall=rock:1.4 @rope_bridge
S 53.3 surf=stone shoulder=0.5            @canyon_floor
C R12 180 L dy=1 w=16                     @obelisk       # obelisk hairpin R12 (V19)
S 40.6 dy=2 w=16                        @switch_1
C R14 180 R dy=2 w=16                   @hairpin_2     # (V19)
S 44 dy=2 w=16                          @switch_2
C R16 180 L dy=2 w=16                   @hairpin_3     # (V19)
S 48.4 dy=2 w=15                          @rim_straight  # item row
WIGGLE R28 45/80/45 L bank=4 dy=2 w=13     @rim_s         # (V19)
C R45 60 R bank=-5                        @rim_corner
S 44 w=14                                 @run_up        # pad before the lip
J ramp=12@8 gap=18 drop=6 land=50 vmin=26 vmax=46 @canyon_mouth  # canyon-mouth jump over the gorge
C R35 60 L bank=5 w=13                    @landing_exit
WIGGLE R30 40/85/40 R bank=4              @mesa_s
S ?b=30                                   @mesa_road
WIGGLE R45 20/50/20 L bank=3 wall=rock:1.4:soft @mesa_road_s  # sand-banked walls into the U-turn
C R40 165 R bank=-9 w=14 wall=rock:1.4    @u_turn        # U-turn (V19)
S 40                                      @zig
C R45 165 L bank=6                        @mesa_sweeper  # (V19)
S ?c=30 shoulder=2                        @sand_flats
WIGGLE R55 15/50/20 R bank=3 shoulder=2   @sand_flats_s
C R30 95 L bank=8 w=14 shoulder=0.5       @mesa_corner   # (V19)
WIGGLE R70 20/40/35 R w=13                @dune_s
C R40 60 L bank=4                         @gate_in       # obelisk-gate corner
C R40 50 R bank=-6                        @gate_out
C R60 80 L bank=4 dy=3                    @rim_return
S ?a=59 w=14 dy=2                         @run_in
CLOSE solve=[?a,?b,?c] length=1950
LINE start at=0
ITEMS at=65,400,660,842,1080,1314,1640,1830 n=4
PAD at=1886,10,826 d=0 len=6 w=4
KEYS 200,450,700,900,1100,1300,1500,1730
# the Hourglass Portal: a 3.5 m side window before hairpin 3 drops you out on the rim straight (skips the last switchback)
WARP hourglass at=@hairpin_3-6 to=@rim_straight+6 d=[3,6.5] transit=0.8 keep
# sandfalls: clip the pour on the outside of each S-chain and the sand steals grip (0.85 / ×0.92)
ZONE surface from=@sandfall_1+8 to=@sandfall_1+24 d=[2,7] surf=sand
ZONE surface from=@sandfall_1+40 to=@sandfall_1+54 d=[-7,-2] surf=sand
ZONE surface from=@sandfall_2+10 to=@sandfall_2+24 d=[-7,-2] surf=sand

# ---- look & dressing (Sunstone Desert kit; art bible: harsh noon in the slot canyon) ----
# 2026-10 stylized pass (docs/design/34-stylized-pass.md, render-only: the .ctrk is unchanged): blue gradient sky and a
# neutral grade instead of the peach haze; crisp banded strata; the rim start straight gets a grandstand, crowd,
# sponsor boards and lantern posts; the whole lap gets dry tufts, pebbles, desert blooms, scrub, small cacti, sandstone
# boulders, saguaros and acacias, with buttes and mesas on the horizon. Canyon slabs and pillars are fitted per side so
# no footprint reaches into the road on the insides of the S-chains and hairpins (the T1 mesa moved off the road).
THEME sunstone_desert sky=day time=12:00 scatter=tree_saguaro,bush_cactus,bush_round,bush_round,rock_cluster,rock_cluster,tree_round_big,rock_pebbles,grass_tuft density=30 hills=10 fogNear=260 fogFar=1600
PROPS kind=clay_pots from=5 to=88 side=R every=16 offset=5 seed=61
PROPS kind=scaffold from=60 to=88 side=L every=26 offset=3 seed=62
# rim start straight: grandstand on the left, crowd and sponsor boards behind the right parapet, lanterns both sides
PROPS kind=grandstand from=38 to=39 side=L every=100 offset=4.5 seed=161
PROPS kind=flag_pole from=22 to=58 side=L every=6 offset=2.2 seed=162
PROPS kind=ad_board_a from=4 to=88 side=R every=24 offset=0.4 seed=163
PROPS kind=ad_board_b from=12 to=88 side=R every=24 offset=0.4 seed=164
PROPS kind=ad_board_c from=20 to=88 side=R every=24 offset=0.4 seed=165
PROPS kind=spectators from=14 to=86 side=R every=24 offset=2.2 jitter=1 seed=166
PROPS kind=lamp_post from=2 to=90 side=both every=20 offset=1.4 seed=167
PROPS kind=ad_board_b from=1898 to=1949 side=R every=16 offset=0.4 scale=1.3-1.3 seed=168
PROPS kind=ad_board_b_l from=1898 to=1949 side=L every=16 offset=0.4 scale=1.3-1.3 seed=182
PROPS kind=ad_board_a from=1906 to=1949 side=both every=16 offset=0.4 scale=1.3-1.3 seed=169
# T1 (rim drop-in, a right-hander): chevron boards raised above the 1.4 m rock wall on the outside (the left-side
# twin ad_board_b_l, so the arrows point into the turn, never back up the road)
PROPS kind=ad_board_b_l from=94 to=136 side=L every=9 offset=2.4 scale=1.45-1.45 seed=170
# ---- fitted rows (canyon slabs/pillars, saguaros, acacias, buttes, mesas, dunes): every footprint, over the
# whole jitter band at the largest scale, stays clear of every road band on this folded lap
# slot canyon: strata slabs and pillars fitted per side (no footprint inside any road band)
PROPS kind=canyon_wall from=140 to=196 side=L every=14 offset=2.5 seed=301
PROPS kind=canyon_wall from=210 to=210 side=L every=14 offset=3.5 seed=302
PROPS kind=canyon_wall from=224 to=224 side=L every=14 offset=7 seed=303
