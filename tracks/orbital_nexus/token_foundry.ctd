# Token Foundry — Orbital Nexus D3 (item-built). A clean orbital factory: the assembly hall's split conveyors, a press
# gauntlet, the server-rack canyon, the coolant-pipe gutter, the elevator ramp up to the gantry deck, the drop into the
# token-stream S, the kiln corner and the cooling line home past the belt sweepers.
@signature hazard:press, conveyor
TRACK token_foundry name="Token Foundry" theme=orbital_nexus diff=3 laps=3 topo=circuit
DEFAULTS w=16 surf=metal wall=barrier:1.2 shoulder=0 blend=18
PROFILE gutter custom pts=[-9:1.6,-8:0.9,-7:0.3,-6:0,6:0,7:0.3,8:0.9,9:1.6]
START pos=(0,0,0) hdg=0
GRID rows=4 cols=2 pitch=7 stagger=3.5 d=4
S ?a                                        @assembly_hall
C R20 90 L bank=5 w=15                      @hall_corner
S 42 w=16                                   @press_gauntlet
C R30 90 R bank=-5                          @press_exit
WIGGLE R20 40/80/40 L w=15                  @rack_canyon
S 36 prof=gutter                            @coolant_pipe
C R16 150 L bank=6 w=15 dy=1.5              @pipe_hairpin
S 60 dy=4.5 w=16                            @elevator_ramp
C R35 30 L dy=2                             @gantry_corner
WIGGLE R145 9/18/9 R                        @gantry_deck
S ?b
WIGGLE R45 35/70/35 R                       @server_s
S 20
CHICANE R40 30/60/30 L                      @loading_chicane
S 20
C R25 90 L dy=-4 bank=5 w=15                @gantry_drop
WIGGLE R32 35/70/35 R dy=-4 w=16                 @token_s
S ?c w=16                                   @token_straight
C R30 90 L bank=6                           @kiln_corner
WIGGLE R60 30/60/30 R                       @cooling_s
C R90 40 L                                  @belt_in
C R90 40 R                                  @belt_out
S 30                                        @to_line
CLOSE solve=[?a,?b,?c] length=1350
LINE start at=@assembly_hall+10
PAD at=@to_line+2,@gantry_deck+92 d=0 len=6 w=4
# assembly-hall belts: the right half runs ×1.15, the left half ×0.85
ZONE conveyor from=@assembly_hall+22 to=@assembly_hall+64 d=[0,8] mul=1.15
ZONE conveyor from=@assembly_hall+22 to=@assembly_hall+64 d=[-8,0] mul=0.85
# the press gauntlet: three stamps staggered left/right, 50% down, always a way through
HAZ press p1 at=@press_gauntlet+8 d=-4.5 box=(5,7,3) period=4 on=0-1.6 tele=0.8 offset=0.0 rise=4
HAZ press p2 at=@press_gauntlet+21 d=4.5 box=(5,7,3) period=4 on=0-1.6 tele=0.8 offset=1.33 rise=4
HAZ press p3 at=@press_gauntlet+34 d=-4.5 box=(5,7,3) period=4 on=0-1.6 tele=0.8 offset=2.67 rise=4
ITEMS at=@elevator_ramp+34,@gantry_deck+120,@token_straight+40,@cooling_s+76 n=5
# ---- dressing (Orbital Nexus kit, foundry mood; stylized pass 2026-10, render-only: the .ctrk is unchanged) ----
# A token factory floor in orbit: conveyors and robot arms along the assembly hall, hazard lamps through the press
# gauntlet, the server-rack canyon and coolant pipes, conveyors, crates, silos and fuel tanks under the gantry deck,
# radiator fins along the cooling line; foundry halls, silos, pylons and antennas behind (clearance pass at the end
# of the file: every footprint ≥ 24 m from the road). The a3 camera stands 8 m right of the run-in and the b2 camera
# 30 m outside the hall corner, so those patches keep low furniture only.
THEME scatter=none hills=0 sky=space mood=foundry fogNear=600 fogFar=4000
# -- assembly hall (start straight): observation stand, banner masts, holo boards, conveyors and robot arms
PROPS kind=grandstand from=@assembly_hall+30 to=@assembly_hall+31 side=L every=100 offset=5.5 seed=301
PROPS kind=flag_pole from=@assembly_hall+2 to=@assembly_hall+18 side=L every=8 offset=2.2 seed=302
PROPS kind=spectators from=@assembly_hall+46 to=@assembly_hall+60 side=L every=14 offset=2.6 jitter=1 seed=303
PROPS kind=ad_board_a from=@assembly_hall+14 to=@hall_corner side=R every=24 offset=0.4 seed=304
PROPS kind=ad_board_b from=@assembly_hall+22 to=@hall_corner side=R every=24 offset=0.4 seed=305
PROPS kind=ad_board_c from=@assembly_hall+30 to=@hall_corner side=R every=24 offset=0.4 seed=306
PROPS kind=ad_board_c from=@to_line+4 to=@to_line+28 side=L every=12 offset=0.4 seed=307
PROPS kind=conveyor_rig from=@to_line to=@assembly_hall+14 side=L every=13 offset=3 seed=308
PROPS kind=robot_arm from=@to_line+6 to=@assembly_hall+14 side=L every=13 offset=6 seed=309
PROPS kind=conveyor_rig from=@assembly_hall+14 to=@hall_corner side=R every=13 offset=4 seed=310
PROPS kind=robot_arm from=@assembly_hall+20 to=@hall_corner side=R every=13 offset=7.5 seed=311
PROPS kind=hazard_lamp from=@to_line to=@hall_corner side=both every=16 offset=0.8 seed=312
# -- T1 (hall corner, left): impact pads and chevron boards on the outside
PROPS kind=tyre_wall from=@hall_corner-2 to=@hall_corner+32 side=R every=1.3 offset=0.6 seed=313
PROPS kind=ad_board_b from=@hall_corner+1 to=@hall_corner+30 side=R every=8 offset=2.6 seed=314
PROPS kind=hazard_lamp from=@hall_corner+4 to=@hall_corner+30 side=R every=12 offset=6 seed=315
# the floor outside T1 (the b2 camera stands on it): low factory furniture only, so the corner stays in view
PROPS kind=cargo_crate from=@hall_corner-6 to=@hall_corner+34 side=R every=8 offset=5 jitter=2 seed=316
PROPS kind=conveyor_rig from=@hall_corner to=@hall_corner+32 side=R every=14 offset=11 seed=317
PROPS kind=robot_arm from=@hall_corner+6 to=@hall_corner+32 side=R every=14 offset=15 seed=318
PROPS kind=token_stack from=@hall_corner+2 to=@hall_corner+32 side=R every=11 offset=19 seed=319
# -- press gauntlet, rack canyon, coolant gutter: hazard lamps, pipe racks, server racks, coolant pipes
PROPS kind=hazard_lamp from=@press_gauntlet to=@press_exit side=both every=10 offset=0.8 seed=320
PROPS kind=pipe_rack from=@press_gauntlet to=@press_exit side=both every=13 offset=3.5 seed=321
PROPS kind=cargo_crate from=@press_exit to=@rack_canyon side=both every=9 offset=2.4 jitter=1 seed=322
PROPS kind=server_rack from=@rack_canyon to=@coolant_pipe side=both every=8 offset=2.6
PROPS kind=coolant_pipe from=@coolant_pipe+4 to=@coolant_pipe+30 side=both every=12 offset=1.2
PROPS kind=pipe_rack from=@rack_canyon to=@pipe_hairpin side=both every=13 offset=6 seed=323
# -- elevator ramp and gantry deck (8 m up): deck-edge bollards and hazard lamps; conveyors, crates, silos and
# fuel tanks on the floor below (offset > 2 stands on the ground under the deck's side)
PROPS kind=light_strip from=@elevator_ramp to=@gantry_drop side=both every=12 offset=0.4 seed=330
# warning lamps sit half a beat (6 m) off the 12 m light-strip posts instead of on top of them
PROPS kind=hazard_lamp from=@elevator_ramp+6 to=@gantry_drop side=both every=36 offset=0.8 seed=331
PROPS kind=conveyor_rig from=@gantry_deck to=@gantry_drop side=both every=26 offset=4 seed=332
PROPS kind=cargo_crate from=@gantry_deck+12 to=@gantry_drop side=both every=26 offset=3.6 jitter=1 seed=333
PROPS kind=robot_arm from=@gantry_deck+6 to=@gantry_drop side=both every=26 offset=8 seed=334
PROPS kind=fuel_tank from=@gantry_deck+40 to=@gantry_drop side=R every=70 offset=12 seed=335
PROPS kind=silo_tank from=@gantry_deck+70 to=@gantry_drop side=L every=90 offset=14 seed=336
PROPS kind=server_rack from=@server_s to=@loading_chicane side=both every=16 offset=12 seed=337
PROPS kind=foundry_building from=@gantry_deck+20 to=@server_s side=both every=72 offset=14 jitter=2 seed=338
PROPS kind=foundry_building from=@loading_chicane to=@gantry_drop side=R every=72 offset=14 jitter=2 seed=339
PROPS kind=foundry_building from=@assembly_hall+36 to=@assembly_hall+37 side=R every=100 offset=13 seed=347
PROPS kind=foundry_building from=@assembly_hall+38 to=@assembly_hall+39 side=L every=100 offset=17 seed=348
PROPS kind=silo_tank from=@press_gauntlet+10 to=@press_exit side=R every=30 offset=8 seed=349
PROPS kind=silo_tank from=@cooling_s+30 to=@belt_in side=R every=50 offset=12 seed=350
# -- token S and straight: token stacks, holo panels, conveyors; the kiln corner; the cooling line
PROPS kind=token_stack from=@token_s to=@token_straight+70 side=both every=28 offset=3
PROPS kind=holo_panel from=@token_straight+20 to=@token_straight+100 side=R every=40 offset=4
PROPS kind=conveyor_rig from=@token_straight to=@kiln_corner side=L every=14 offset=4 seed=340
PROPS kind=hazard_lamp from=@token_s+6 to=@kiln_corner+40 side=both every=24 offset=0.8 seed=341
PROPS kind=fuel_tank from=@kiln_corner to=@kiln_corner+40 side=R every=40 offset=6 seed=342
PROPS kind=radiator_fin from=@cooling_s to=@belt_in side=both every=12 offset=4 seed=343
PROPS kind=server_rack from=@cooling_s to=@belt_out+40 side=L every=24 offset=9
PROPS kind=pipe_rack from=@belt_in to=@to_line side=both every=13 offset=4 seed=344
PROPS kind=cargo_crate from=@belt_in to=@to_line side=both every=11 offset=2.2 jitter=1 seed=345
PROPS kind=light_strip from=@token_s to=@elevator_ramp side=both every=12 offset=0.4 seed=346
