# Orbital Express — Orbital Nexus D5 (speed, one-lap journey). From the launch tube over the sky rail, through the
# vertical loop and the zero-g tube, across the station's train line, down the docking-ring helix, past the laser gates
# and through the warp gate into the city of towers for the finale.
@signature loop, zeroG, helix, warp, rail, hazard:train, hazard:press, jump, kill
TRACK orbital_express name="Orbital Express" theme=orbital_nexus diff=5 laps=1 topo=p2p finishBefore=266
DEFAULTS w=12 surf=metal wall=barrier:1.1 shoulder=0 blend=18
START pos=(0,0,0) hdg=0
GRID rows=4 cols=2 pitch=6.5 stagger=3.2 d=3
S 140                                       @launch_tube
C R30 90 L bank=5                           @tube_exit
S 100                                       @sky_rail
WIGGLE R60 30/60/30 L                       @sky_sweep
C R120 90 L bank=4                          @sky_sweeper
WIGGLE R30 40/80/40 R                       @sky_s
WIGGLE R30 40/80/40 L                       @pylon_s
S 30                                        @loop_in
LOOP R12 shift=18 ease=15 side=L                @loop
C R20 120 L bank=6                          @loop_exit
S 20                                        @zerog_in
WIGGLE R140 20/40/20 L gravity=low:0.35     @zerog_tube
S 20                                        @zerog_out
C R20 180 R bank=-6                         @tube_hairpin
WIGGLE R30 30/60/30 R wall=barrier:1.1:soft  @glass_s
WIGGLE R30 30/60/30 R                       @glass_s2
S 70                                        @train_straight
C R25 90 L                                  @station_corner
HELIX R28 360 R dy=-12 bank=-10 wallOut=barrier:1.5   @docking_helix
S 30 dy=-1                                  @ring_exit
WIGGLE R60 30/60/30 R                       @ring_s
C R100 90 R dy=-8 bank=-4                   @station_sweeper
C R14 180 R dy=-4 bank=-6                   @laser_hairpin
S 40 dy=-4                                  @laser_run
WIGGLE R35 35/70/35 L dy=-2 wall=barrier:1.1:soft @laser_s
S 30                                        @warp_approach
# the rail gap: a jump across the void between two sky-rail decks (kill floor below the gap)
J ramp=10@8 gap=10 drop=2 land=45 wland=14 vmin=24 vmax=46 w=12 @rail_gap
S 20                                        @gate_run
S 60 warp=gate                              @warp_gate
S 70                                        @city_1
WIGGLE R60 30/60/30 L                       @tower_canyon
C R120 90 R bank=4                          @tower_sweeper
WIGGLE R60 30/60/30 R                       @bridge_s
WIGGLE R30 40/80/40 L                       @skyscraper_s
S 70                                        @city_2
WIGGLE R80 25/50/25 L wall=barrier:1.1:soft  @holo_s
C R100 90 L bank=4                          @holo_sweeper
WIGGLE R80 30/60/30 L                       @neon_s
WIGGLE R60 30/60/30 R                       @final_s
C R16 150 R bank=-6                         @plaza_hairpin
WIGGLE R40 30/60/30 L wall=barrier:1.1:soft  @plaza_s
S 40                                        @avenue
WIGGLE R60 25/50/25 R wall=barrier:1.1:soft  @arch_s
C R35 90 L bank=5                           @final_corner
S 40                                        @finish_straight
S 40                                        @finish_gate
# run-off after the finish (finishBefore=266): cruising finishers keep rolling instead of dropping off the path end
C R60 60 L wall=barrier:1.4                 @runoff
S 60
C R60 60 R wall=barrier:1.4
S 60
LINE start at=@launch_tube+40
WARP gate transit=0.8 keep
PAD at=@launch_tube+45 d=-3 len=6 w=4
PAD at=@launch_tube+45 d=3 len=6 w=4
PAD at=@sky_rail+2 d=-3 len=6 w=4
# the sky rail: a grind lane along the left of the sky-rail straight (boost-rail, 38 → 44 m/s)
RAIL skyrail host=main from=@sky_rail+8 to=@sky_rail+96 d=[@sky_rail+8:3,@sky_rail+22:4.5,@sky_rail+80:4.5,@sky_rail+96:3] h=1.0
     capture=(dMax 2.0, hdg 25, vMin 15) speed=(min 38, accel 4, max 44) gauge=0.30/s
# freight trains cross the station straight every 8 s (lights and horn 1 s ahead)
HAZ train freight at=@train_straight+35 d=0 box=(24,3.4,4) period=8 on=0-2.4 tele=1.0 offset=0 span=20
# laser gates on the hairpin exit: each closes half the road for 1.5 s of every 4 s, never both at once
HAZ press laser1 at=@laser_run+8 d=-3 box=(1.5,6,3) period=4 on=0-1.5 tele=0.6 offset=0 effect=block rise=3 prop=hazard_laser
HAZ press laser2 at=@laser_run+22 d=3 box=(1.5,6,3) period=4 on=0-1.5 tele=0.6 offset=2 effect=block rise=3 prop=hazard_laser
ITEMS at=@launch_tube+110,@sky_sweep+23,@loop_in+16,@zerog_tube+4,@zerog_tube+159,@ring_s+20,@station_sweeper+64,@city_1+19,@tower_canyon+109,@tower_sweeper+139,@bridge_s+105,@city_2+56,@holo_sweeper+20,@neon_s+23,@avenue+19 n=5
THEME scatter=station_pylon density=4 hills=0 sky=space
