# Orbital Express — Orbital Nexus D5 (speed, one-lap journey). From the launch tube over the sky rail, through the
# vertical loop and the zero-g tube, across the station's train line, down the docking-ring helix, past the laser gates
# and through the warp gate into the city of towers for the finale.
@signature loop, zeroG, helix, warp, rail, hazard:train, hazard:press, jump, kill
TRACK orbital_express name="Orbital Express" theme=orbital_nexus diff=5 laps=1 topo=p2p finishBefore=266
DEFAULTS w=12 surf=metal wall=barrier:1.1 shoulder=0 blend=18
START pos=(0,0,0) hdg=0
GRID rows=4 cols=2 pitch=6.5 stagger=3.2 d=3
S 140                                       @launch_tube
C R30 90 L bank=5                           @tube_exit
S 100                                       @sky_rail
WIGGLE R60 30/60/30 L                       @sky_sweep
C R120 90 L bank=4                          @sky_sweeper
WIGGLE R30 40/80/40 R                       @sky_s
WIGGLE R30 40/80/40 L                       @pylon_s
S 30                                        @loop_in
LOOP R12 shift=18 ease=15 side=L                @loop
C R20 120 L bank=6                          @loop_exit
S 20                                        @zerog_in
WIGGLE R140 20/40/20 L gravity=low:0.35     @zerog_tube
S 20                                        @zerog_out
C R20 180 R bank=-6                         @tube_hairpin
WIGGLE R30 30/60/30 R wall=barrier:1.1:soft  @glass_s
WIGGLE R30 30/60/30 R                       @glass_s2
S 70                                        @train_straight
C R25 90 L                                  @station_corner
HELIX R28 360 R dy=-12 bank=-10 wallOut=barrier:1.5   @docking_helix
S 30 dy=-1                                  @ring_exit
WIGGLE R60 30/60/30 R                       @ring_s
C R100 90 R dy=-8 bank=-4                   @station_sweeper
C R14 180 R dy=-4 bank=-6                   @laser_hairpin
S 40 dy=-4                                  @laser_run
WIGGLE R35 35/70/35 L dy=-2 wall=barrier:1.1:soft @laser_s
S 30                                        @warp_approach
# the rail gap: a jump across the void between two sky-rail decks (kill floor below the gap)
J ramp=10@8 gap=10 drop=2 land=45 wland=14 vmin=24 vmax=46 w=12 @rail_gap
S 20                                        @gate_run
S 60 warp=gate                              @warp_gate
S 70                                        @city_1
WIGGLE R60 30/60/30 L                       @tower_canyon
C R120 90 R bank=4                          @tower_sweeper
WIGGLE R60 30/60/30 R                       @bridge_s
WIGGLE R30 40/80/40 L                       @skyscraper_s
S 70                                        @city_2
WIGGLE R80 25/50/25 L wall=barrier:1.1:soft  @holo_s
C R100 90 L bank=4                          @holo_sweeper
WIGGLE R80 30/60/30 L                       @neon_s
WIGGLE R60 30/60/30 R                       @final_s
C R16 150 R bank=-6                         @plaza_hairpin
WIGGLE R40 30/60/30 L wall=barrier:1.1:soft  @plaza_s
S 40                                        @avenue
WIGGLE R60 25/50/25 R wall=barrier:1.1:soft  @arch_s
C R35 90 L bank=5                           @final_corner
S 40                                        @finish_straight
S 40                                        @finish_gate
# run-off after the finish (finishBefore=266): cruising finishers keep rolling instead of dropping off the path end
C R60 60 L wall=barrier:1.4                 @runoff
S 60
C R60 60 R wall=barrier:1.4
S 60
LINE start at=@launch_tube+40
WARP gate transit=0.8 keep
PAD at=@launch_tube+45 d=-3 len=6 w=4
PAD at=@launch_tube+45 d=3 len=6 w=4
PAD at=@sky_rail+2 d=-3 len=6 w=4
# the sky rail: a grind lane along the left of the sky-rail straight (boost-rail, 38 → 44 m/s)
RAIL skyrail host=main from=@sky_rail+8 to=@sky_rail+96 d=[@sky_rail+8:3,@sky_rail+22:4.5,@sky_rail+80:4.5,@sky_rail+96:3] h=1.0
     capture=(dMax 2.0, hdg 25, vMin 15) speed=(min 38, accel 4, max 44) gauge=0.30/s
# freight trains cross the station straight every 8 s (lights and horn 1 s ahead)
HAZ train freight at=@train_straight+35 d=0 box=(24,3.4,4) period=8 on=0-2.4 tele=1.0 offset=0 span=20
# laser gates on the hairpin exit: each closes half the road for 1.5 s of every 4 s, never both at once
HAZ press laser1 at=@laser_run+8 d=-3 box=(1.5,6,3) period=4 on=0-1.5 tele=0.6 offset=0 effect=block rise=3 prop=hazard_laser
HAZ press laser2 at=@laser_run+22 d=3 box=(1.5,6,3) period=4 on=0-1.5 tele=0.6 offset=2 effect=block rise=3 prop=hazard_laser
ITEMS at=@launch_tube+110,@sky_sweep+23,@loop_in+16,@zerog_tube+4,@zerog_tube+159,@ring_s+20,@station_sweeper+64,@city_1+19,@tower_canyon+109,@tower_sweeper+139,@bridge_s+105,@city_2+56,@holo_sweeper+20,@neon_s+23,@avenue+19 n=5
# ---- dressing (Orbital Nexus kit, station mood; stylized pass 2026-10, render-only: the .ctrk is unchanged) ----
# The sky rail runs on hull plinths above the station floor (plated, with lit seams); beside the road stand light
# bollards, antenna masts, solar arrays, cargo pods, fuel tanks and radiator fins, habitat modules sit lower down,
# and a clearance pass (end of file) places pylons, habitats, solar fields and, in the city, the towers ≥ 26 m from
# every road at any height. Rings turn the launch straight and the zero-g run into tubes; the docking ring stands
# in the eye of the helix. The a3 camera stands 10 m right of the launch tube behind the grid and the b2 camera 30 m
# outside the tube exit, so those patches keep low furniture only. No fog haze (fogNear 600).
THEME scatter=none hills=0 sky=space fogNear=600 fogFar=5000
# -- launch tube (start straight): observation stand, banner masts, spectators, holo boards and panels, rings
PROPS kind=grandstand from=@launch_tube+14 to=@launch_tube+15 side=L every=100 offset=4.5 seed=401
PROPS kind=flag_pole from=@launch_tube+30 to=@launch_tube+138 side=L every=9 offset=2.2 seed=402
PROPS kind=spectators from=@launch_tube+30 to=@launch_tube+60 side=L every=15 offset=3.4 jitter=1 seed=403
PROPS kind=ad_board_a from=@launch_tube+20 to=@launch_tube+138 side=R every=24 offset=0.4 seed=404
PROPS kind=ad_board_b from=@launch_tube+28 to=@launch_tube+138 side=R every=24 offset=0.4 seed=405
PROPS kind=ad_board_c from=@launch_tube+36 to=@launch_tube+138 side=R every=24 offset=0.4 seed=406
PROPS kind=holo_panel from=@launch_tube+66 to=@launch_tube+130 side=L every=32 offset=4.5
PROPS kind=antenna_mast from=@launch_tube+10 to=@launch_tube+130 side=R every=30 offset=6 seed=407
PROP kind=launch_ring at=(62.0,0.0,0.0) yaw=90 scale=1
PROP kind=launch_ring at=(74.0,0.0,0.0) yaw=90 scale=1
PROP kind=launch_ring at=(86.0,0.0,0.0) yaw=90 scale=1
PROP kind=launch_ring at=(98.0,0.0,0.0) yaw=90 scale=1
# -- T1 (tube exit, left): impact pads and chevron boards on the outside
PROPS kind=tyre_wall from=@tube_exit-2 to=@tube_exit+44 side=R every=1.3 offset=0.6 seed=410
PROPS kind=ad_board_b from=@tube_exit+1 to=@tube_exit+44 side=R every=8 offset=2.6 seed=411
# -- the whole run: light bollards on the deck edges, station hardware on the plinths beside the road
PROPS kind=light_strip along=main side=both every=12 offset=0.4 seed=420
# (segments skip the vertical loop, the tube hairpin, the docking helix and the laser descent, where the road
# passes over itself)
PROPS kind=antenna_mast from=@sky_rail+40 to=@loop_in-12 side=both every=48 offset=4.5 jitter=1.5 seed=4210
PROPS kind=antenna_mast from=@zerog_in+64 to=@tube_hairpin-8 side=both every=48 offset=4.5 jitter=1.5 seed=4211
PROPS kind=antenna_mast from=@glass_s2+50 to=@docking_helix-30 side=both every=48 offset=4.5 jitter=1.5 seed=4212
PROPS kind=antenna_mast from=@ring_s+80 to=@laser_hairpin-130 side=both every=48 offset=4.5 jitter=1.5 seed=4213
PROPS kind=solar_array from=@sky_rail to=@loop_in-12 side=both every=48 offset=5 jitter=1.5 seed=4220
PROPS kind=solar_array from=@zerog_in+24 to=@tube_hairpin-8 side=both every=48 offset=5 jitter=1.5 seed=4221
PROPS kind=solar_array from=@glass_s2+10 to=@docking_helix-30 side=both every=48 offset=5 jitter=1.5 seed=4222
PROPS kind=solar_array from=@ring_s+40 to=@laser_hairpin-130 side=both every=48 offset=5 jitter=1.5 seed=4223
PROPS kind=cargo_crate from=@sky_rail to=@loop_in-12 side=both every=26 offset=2.4 jitter=1 seed=4230
PROPS kind=cargo_crate from=@zerog_in+24 to=@tube_hairpin-8 side=both every=26 offset=2.4 jitter=1 seed=4231
PROPS kind=cargo_crate from=@glass_s2+10 to=@docking_helix-30 side=both every=26 offset=2.4 jitter=1 seed=4232
PROPS kind=cargo_crate from=@ring_s+40 to=@laser_hairpin-130 side=both every=26 offset=2.4 jitter=1 seed=4233
PROPS kind=fuel_tank from=@sky_rail+30 to=@loop_in-12 side=both every=144 offset=6 seed=4240
PROPS kind=fuel_tank from=@zerog_in+54 to=@tube_hairpin-8 side=both every=144 offset=6 seed=4241
PROPS kind=fuel_tank from=@glass_s2+40 to=@docking_helix-30 side=both every=144 offset=6 seed=4242
PROPS kind=fuel_tank from=@ring_s+70 to=@laser_hairpin-130 side=both every=144 offset=6 seed=4243
PROPS kind=radiator_fin from=@sky_rail+14 to=@loop_in-12 side=both every=96 offset=4.5 seed=4250
PROPS kind=radiator_fin from=@zerog_in+38 to=@tube_hairpin-8 side=both every=96 offset=4.5 seed=4251
PROPS kind=radiator_fin from=@glass_s2+24 to=@docking_helix-30 side=both every=96 offset=4.5 seed=4252
PROPS kind=radiator_fin from=@ring_s+54 to=@laser_hairpin-130 side=both every=96 offset=4.5 seed=4253
PROPS kind=habitat_house from=@sky_rail to=@loop_in-12 side=both every=110 offset=14 jitter=4 seed=4260
PROPS kind=habitat_house from=@zerog_in+24 to=@zerog_out side=both every=110 offset=14 jitter=4 seed=4261
PROPS kind=habitat_house from=@glass_s2+10 to=@docking_helix-30 side=both every=110 offset=14 jitter=4 seed=4262
PROPS kind=habitat_house from=@ring_s+40 to=@laser_hairpin-130 side=both every=110 offset=14 jitter=4 seed=4263
PROPS kind=holo_panel from=@glass_s to=@station_corner side=both every=60 offset=4 seed=427
PROP kind=launch_ring at=(-151.7,0.0,-297.1) yaw=34 scale=1
PROP kind=launch_ring at=(-132.6,0.0,-274.1) yaw=46 scale=1
PROP kind=launch_ring at=(-110.8,0.0,-253.5) yaw=42 scale=1
PROP kind=launch_ring at=(-93.3,0.0,-229.2) yaw=30 scale=1
PROP kind=launch_ring at=(-81.4,0.0,-201.7) yaw=17 scale=1
PROP kind=launch_ring at=(-74.6,0.0,-172.5) yaw=15 scale=1
PROP kind=launch_ring at=(-63.8,0.0,-144.6) yaw=27 scale=1
PROP kind=docking_ring at=(-227.6,-22.6,-299.5) yaw=30 scale=0.65
# -- the city of towers (y −33, on the station floor): towers set back 14 m, holo panels, token stacks, habitats
PROPS kind=city_tower from=@city_1 to=@plaza_hairpin-24 side=both every=46 offset=14 jitter=3 scale=0.8-1.2 seed=430
PROPS kind=city_tower from=@avenue+24 to=@finish_gate side=both every=46 offset=14 jitter=3 scale=0.8-1.2 seed=436
PROPS kind=holo_panel from=@city_1 to=@avenue side=L every=110 offset=4
PROPS kind=holo_panel from=@city_1+55 to=@avenue side=R every=110 offset=4 seed=431
PROPS kind=token_stack from=@city_2 to=@holo_sweeper+150 side=R every=60 offset=5
PROPS kind=habitat_house from=@city_1+20 to=@finish_gate side=both every=92 offset=4 jitter=2 seed=432
PROPS kind=cargo_crate from=@city_1 to=@finish_gate side=both every=21 offset=2.4 jitter=1 seed=433
PROPS kind=flag_pole from=@final_corner to=@finish_gate side=both every=10 offset=2.2 seed=434
PROPS kind=spectators from=@finish_straight to=@finish_gate+30 side=both every=16 offset=2.6 jitter=1 seed=435
