# Meadow Loop / 초원 순환로 — Clayhill Village, D1, 3 × 1400 m, item★ / tutorial (11-track-spec §12.1).
# Wide loop with grass shoulders (the off-road lesson): windmill run, meadow S past the sheep, the stone hump bridge
# over the creek, the village-green hairpin round the bandstand, the market lane and the hay-bale S home.
# Tutorial signboards: drift → boost → instant boost. Block-out angles re-balanced for exact closure (T1 110°,
# hairpin 175°, kinks 40/45°); every named section keeps its order, radius and role.
@signature pads, surfaces, jump
TRACK meadow_loop name="Meadow Loop" theme=clayhill_village diff=1 laps=3 topo=circuit
DEFAULTS w=18 surf=asphalt wall=fence:1.0 shoulder=3 shoulderSurf=grass blend=16
START pos=(0,0,0) hdg=0
GRID rows=4 cols=2 pitch=7 stagger=3.5 d=4
S 200                                     @home         # home straight; pads +110/+160; tutorial arch "드리프트!"
C R40 110 L bank=6                        @first_drift  # T1 "first drift" (V19)
S 71                                      @windmill_run # item row
WIGGLE R60 45/75/40 L bank=3              @meadow_s     # sheep-field S-bends
S ?b=56 dy=2                              @bridge_up    # stone-bridge approach
J ramp=8@6 gap=4 drop=1.5 land=50 vmin=15 vmax=46 @bridge  # tutorial hop over the creek (kicker, 6 m gap, landing)
C R50 40 R bank=-4 w=18 wall=fence:1.0    @bridge_exit
C R40 175 L bank=7                        @green        # village-green hairpin round the bandstand (V19)
C R70 45 R bank=-3                        @market_kink
S ?c=118 dy=-0.5                            @market_lane  # item row, stalls and bunting
C R60 80 L bank=5                         @windmill_corner
WIGGLE R60 25/70/25 L bank=3 wall=fence:1.0:soft @hay_s  # hay-bale S (soft bales)
S 72 wall=fence:1.0:soft                 @hay_straight
C R45 90 L bank=6 wall=fence:1.0          @last_corner  # onto the home straight (V19)
S ?a=93                                   @run_in
CLOSE solve=[?a,?b,?c] length=1400
LINE start at=0
ITEMS at=160,320,480,870,1040,1200 n=5
PAD at=55,105 d=0 len=6 w=4
KEYS 240,460,660,860,1070,1280

# ---- look & dressing (Clayhill Village kit; art bible: late-morning meadow) ----
THEME clayhill_village sky=day time=10:00 scatter=orchard_tree,tree_round_big,tree_round_big,bush_round,bush_round,cypress,hay_bale,sheep,rock_cluster,flower_patch,cottage density=42 hills=7 fogNear=250 fogFar=1500
PROPS kind=cottage from=8 to=190 side=R every=30 offset=7 jitter=3 seed=3
PROPS kind=flower_box from=85 to=195 side=L every=20 offset=1 seed=4
PROPS kind=cafe_table from=90 to=180 side=L every=26 offset=5 jitter=2 seed=5
# start straight: grandstand opposite the cottages, sponsor boards behind the rail fence, tyre wall round T1
PROPS kind=grandstand from=45 to=46 side=L every=100 offset=5.5 seed=19
PROPS kind=ad_board_a from=4 to=190 side=R every=24 offset=0.4 seed=20
PROPS kind=ad_board_b from=12 to=190 side=R every=24 offset=0.4 seed=21
PROPS kind=ad_board_c from=20 to=190 side=R every=24 offset=0.4 seed=22
PROPS kind=ad_board_b from=1352 to=1399 side=R every=16 offset=0.4 seed=23
PROPS kind=ad_board_b_l from=1352 to=1399 side=L every=16 offset=0.4 seed=23
PROPS kind=ad_board_a from=1360 to=1399 side=both every=16 offset=0.4 seed=24
PROPS kind=ad_board_c from=80 to=196 side=L every=36 offset=0.4 seed=25
PROPS kind=tyre_wall from=203 to=272 side=R every=1.3 offset=0.6 seed=26
PROPS kind=ad_board_b from=206 to=268 side=R every=10 offset=2.4 seed=27
# ---- dressing pass (2026-10): ground cover at the fence, shrubs and shade trees behind it, tree lines on the horizon,
# village life on the start straight (render-only: the .ctrk is unchanged)
PROPS kind=grass_tuft side=both every=0.8 offset=0.2 jitter=8 scale=1.0-1.8 seed=41
PROPS kind=flower_patch side=both every=5 offset=0.8 jitter=9 scale=0.8-1.3 seed=42
PROPS kind=bush_round side=both every=11 offset=3 jitter=9 scale=0.7-1.3 seed=43
PROPS kind=rock_cluster side=both every=23 offset=4 jitter=12 scale=0.6-1.4 seed=44
# (no big shade trees behind the grandstand / grid on the left: the stand and the first corner stay readable)
PROPS kind=tree_round_big side=R every=17 offset=14 jitter=18 scale=0.8-1.3 seed=45
PROPS kind=tree_round_big from=95 to=1340 side=L every=17 offset=14 jitter=18 scale=0.8-1.3 seed=52
PROPS kind=tree_clump side=both every=26 offset=60 jitter=50 scale=0.9-1.4 seed=46
PROPS kind=tree_clump side=both every=34 offset=125 jitter=50 scale=1.0-1.6 seed=47
PROPS kind=lamp_post from=2 to=195 side=both every=20 offset=1.6 seed=48
PROPS kind=flag_pole from=22 to=70 side=L every=6 offset=2.6 seed=49
PROPS kind=spectators from=96 to=190 side=L every=24 offset=2.4 jitter=1 seed=50
PROPS kind=spectators from=1352 to=1399 side=R every=16 offset=1.6 jitter=1 seed=51
PROP kind=hot_air_balloon at=(70.0,42.0,95.0) yaw=0 scale=1
PROP kind=hot_air_balloon at=(195.0,55.0,-150.0) yaw=40 scale=1.2
PROP kind=hot_air_balloon at=(-95.0,48.0,-60.0) yaw=10 scale=0.9
PROPS kind=orchard_tree from=200 to=277 side=L every=14 offset=6 jitter=4 seed=6
PROPS kind=cypress from=277 to=348 side=L every=12 offset=4 seed=7
PROPS kind=sheep from=350 to=510 side=both every=16 offset=8 jitter=14 scale=0.9-1.2 seed=8
PROPS kind=hay_bale from=380 to=500 side=R every=40 offset=18 jitter=8 seed=9
PROPS kind=cypress from=662 to=780 side=R every=15 offset=5 seed=10
PROPS kind=cafe_table from=665 to=775 side=L every=20 offset=4 seed=11
PROPS kind=market_stall from=840 to=950 side=both every=15 offset=2 seed=12
PROPS kind=townhouse from=785 to=955 side=both every=13 offset=10 seed=13
PROPS kind=orchard_tree from=955 to=1039 side=R every=16 offset=6 jitter=6 seed=14
PROPS kind=hay_bale from=1040 to=1236 side=both every=10 offset=0.8 seed=15
PROPS kind=sheep from=1170 to=1236 side=R every=14 offset=10 jitter=10 seed=16
PROPS kind=cottage from=1240 to=1395 side=R every=28 offset=7 jitter=3 seed=17
PROPS kind=flower_box from=1310 to=1395 side=L every=18 offset=1 seed=18
# landmarks (poses from the baked centreline): start bunting, T1 tutorial board, windmills, creek, bandstand green,
# market bunting, the stone arch on the run-in
PROP kind=bunting at=(30.0,-0.3,0.0) yaw=-90 scale=1
PROP kind=bunting at=(185.0,-0.3,0.0) yaw=-90 scale=1
PROP kind=signboard at=(172.0,-0.3,14.0) yaw=90 scale=1
PROP kind=windmill at=(256.5,-0.3,-101.2) yaw=-160 scale=1.1
PROP kind=creek at=(112.6,-1.0,-309.4) yaw=30 scale=1
PROP kind=canal_boat at=(133.4,0.1,-321.4) yaw=30 scale=1
PROP kind=bandstand at=(41.1,0.2,-395.7) yaw=77 scale=1
PROP kind=weathervane at=(50.8,0.2,-405.8) yaw=47 scale=1
PROP kind=bunting at=(-67.0,0.0,-342.0) yaw=120 scale=1
PROP kind=bunting at=(-110.3,-0.2,-317.0) yaw=120 scale=1
PROP kind=windmill at=(-120.9,-0.3,-259.4) yaw=160 scale=1.2
PROP kind=stone_arch at=(-60.0,-0.3,-0.0) yaw=-90 scale=1
PROP kind=fountain at=(-95.3,-0.3,-30.0) yaw=-99 scale=1
