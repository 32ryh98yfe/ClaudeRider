# Aurora Summit / 오로라 정상 활강 — Frostbyte Glacier, D5, 1 × 3700 m point-to-point, speed★ (11-track-spec §12.6).
# Night under a dancing aurora, headlights on: summit gate, cornice bends, the steep chute, the ice-shelf and
# cornice S-chains, the spiral descent (switchback fallback), the moraine, the glacier hairpin, the avalanche gully,
# the serac S, the ski jump (down-ramp fallback), the pine slalom, the ice-bridge hairpin, the frozen lake, the
# lodge hairpin and S, the birch and village S, the chapel hairpin and the valley mouth to the finish gate.
# Summit-to-valley descent −120 m, no stretch steeper than 15%. Connecting-corner angles re-balanced so the
# descent never crosses itself (stacked levels arrive with F6).
@signature jump, ledge, kill, helix, stacked
@fallback helix -> "2 × C R16 170° switchback hairpins with the same −24 m drop" when=F6
@fallback stacked -> "switchback hairpins stay on one level (no overlap)" when=F6
TRACK aurora_summit name="Aurora Summit" theme=frostbyte_glacier diff=5 laps=1 topo=p2p finishBefore=182
DEFAULTS w=12 surf=asphalt wall=barrier:1.1 shoulder=0 shoulderSurf=snow blend=20   # no shoulder strip: one draw per visible chunk run fewer (V20, Low tier)
START pos=(0,0,0) hdg=0
GRID rows=4 cols=2 pitch=7 stagger=3.5 d=3
S 46 w=13                                 @grid          # grid lead-in behind the start gate
S 90                                      @summit_gate   # start gate; pad
C R30 90 L dy=-4 bank=6 w=12              @summit_drop   # (V19)
C R20 120 R dy=-4 bank=-8                 @cornice_bend  # (V19)
C R140 12 L dy=-3                         @chute         # steep chute (10%)
C R140 12 R dy=-3
WIGGLE R60 30/60/30 L dy=-6 bank=4        @upper_s
C R120 95 L dy=-8                         @upper_sweeper
S 25 w=13                                 @shelf_brake
WIGGLE R15 35/70/35 L dy=-3 w=13 wallL=barrier:0.8 wallR=none:0:ledgeKill kill=cornice @ice_shelf_s  # ice shelf: open valley edge (V19 ×2)
S 22 w=13 wallR=barrier:0.8                @shelf_link
WIGGLE R16 30/60/30 R dy=-3 w=13 wallL=none:0:ledgeKill kill=cornice @cornice_s  # cornice: open edge (V19 ×2)
S 45 w=13 wall=barrier:1.1                @shelf_run
S 50 dy=-5 w=12                           @spiral_a      # spiral descent fallback: switchback 1
C R16 170 R dy=-5 bank=-6 w=14            @spiral_1      # (V19)
S 50 dy=-5 w=12                           @spiral_b
C R16 170 L dy=-5 bank=6 w=14             @spiral_2      # (V19)
C R140 10 R dy=-1 w=12                    @spiral_exit
C R140 10 L dy=-1
WIGGLE R60 35/60/30 R dy=-4 bank=4        @moraine_s
C R100 95 R dy=-6                         @moraine_sweeper
C R12 180 L bank=6 w=14                   @glacier_hairpin # R12 (V19)
C R140 12 L dy=-2.5 w=12 wall=rock:3      @gully         # avalanche-gully tunnel
C R140 12 R dy=-2.5
WIGGLE R18 35/70/35 R dy=-2 w=13 wall=barrier:1.1 @gully_s   # (V19 ×2)
WIGGLE R16 30/60/30 L dy=-2 wall=barrier:1.1:soft @serac_s  # snow-padded (AI hard hits)       # (V19 ×2)
S 68 dy=-4 w=13 wall=barrier:1.1          @ski_runup     # pads before the lip
J ramp=12@8 gap=10 drop=3 land=60 vmin=20 vmax=46 @ski_jump  # ski jump: ~0.8 s of air (longer flights trip the no-ground respawn, see L5 request)
S 26 dy=-2
C R40 90 L bank=5 w=12                    @landing_bend
WIGGLE R80 30/60/30 L dy=-2               @landing_s
S 20 w=13                                 @slalom_brake
WIGGLE R22 40/75/40 L dy=-2 bank=5 wall=barrier:1.1:soft @pine_slalom  # snow-padded (AI hard hits)   # (V19 ×2)
S 20 wall=barrier:1.1                     @slalom_link
WIGGLE R22 35/75/40 R dy=-2 bank=7        @pine_slalom_2 # (V19)
S 54 dy=-4                                @lower_valley
C R16 135 R bank=-7 w=14                  @ice_bridge    # (V19)
S 65 w=15 surf=ice shoulder=0 @frozen_lake # frozen-lake straight
C R120 75 R dy=-2 surf=asphalt shoulder=0 shoulderSurf=snow @lake_sweeper
WIGGLE R60 40/60/30 L dy=-2               @lake_shore_s
WIGGLE R30 40/70/40 R dy=-2 bank=4        @aurora_s
S 20 w=13                                 @lodge_brake
C R12 180 L bank=6 w=14                   @lodge_hairpin # (V19)
WIGGLE R20 30/60/30 R dy=-2 bank=5 w=13   @lodge_s       # (V19)
C R140 13 R w=12                          @lodge_straight
C R140 13 L
WIGGLE R80 30/60/40 R dy=-2               @lodge_road_s
C R90 120 L dy=-2                         @lodge_sweeper
WIGGLE R60 30/60/30 R dy=-2               @birch_s
WIGGLE R25 35/65/35 L dy=-1 bank=5 wall=barrier:1.1:soft @village_s  # snow-padded (AI hard hits)     # (V19)
S 20 w=13 wall=barrier:1.1                @chapel_brake
C R14 180 R bank=-6 w=14                  @chapel_hairpin # (V19)
S 15 w=13                                 @chapel_exit
WIGGLE R18 35/65/35 L dy=-1 bank=6        @chapel_s      # (V19)
C R140 12 L dy=-1                         @final_descent
C R140 12 R dy=-1
C R100 90 L dy=-2                         @valley_mouth
C R35 90 R bank=-5                        @final_corner
S 132 w=13                                @finish        # finish gate; long run-off after it
C R80 60 L w=14 wall=barrier:1.4          @runoff
S 12
LINE start at=46
KILL cornice belowY=-40 aabb=(491,-162 .. 611,4) surf=void
ITEMS at=250,480,745,900,1080,1240,1390,1800,2075,2290,2440,2725,3000,3170,3450 n=4
PAD at=60,1500,1522 d=0 len=6 w=4
KEYS 200,500,800,1100,1400,1700,2000,2300,2600,2900,3200,3500

# ---- look & dressing (Frostbyte Glacier kit; art bible: 22:00 under the aurora, headlights on) ----
THEME frostbyte_glacier sky=aurora time=22:00 headlights=on scatter=pine_snow,snowbank,serac density=4 hills=14
PROPS kind=snow_cabin from=2 to=130 side=L every=20 offset=6 jitter=2 seed=101
PROPS kind=avalanche_net from=136 to=224 side=R every=8 offset=3 seed=102
PROPS kind=pine_snow from=211 to=606 side=both every=13 offset=5 jitter=5 seed=103
PROPS kind=snowbank from=409 to=606 side=both every=24 offset=10 jitter=6 seed=104
PROPS kind=ice_spire from=610 to=668 side=L every=9 offset=1.5 seed=105
PROPS kind=ice_spire from=694 to=724 side=R every=9 offset=1.5 seed=106
PROPS kind=serac from=726 to=768 side=both every=14 offset=5 seed=107
PROPS kind=avalanche_net from=770 to=1012 side=both every=10 offset=3 seed=108
PROPS kind=pine_snow from=965 to=1145 side=both every=12 offset=5 jitter=5 seed=109
PROPS kind=serac from=1145 to=1310 side=both every=18 offset=8 jitter=6 seed=110
PROPS kind=ice_spire from=1407 to=1484 side=both every=10 offset=2 jitter=2 seed=111
PROPS kind=pine_snow from=1485 to=1550 side=both every=10 offset=4 seed=112
PROPS kind=pine_snow from=1661 to=1890 side=both every=13 offset=5 jitter=5 seed=113
PROPS kind=pine_snow from=1911 to=2047 side=both every=8 offset=2 jitter=2 seed=114
PROPS kind=snowbank from=2140 to=2204 side=both every=12 offset=3 seed=115
PROPS kind=pine_snow from=2205 to=2496 side=both every=12 offset=5 jitter=4 seed=116
PROPS kind=pine_snow from=2498 to=2596 side=both every=12 offset=5 jitter=4 seed=117
PROPS kind=snow_cabin from=2634 to=2920 side=both every=26 offset=7 jitter=3 seed=118
PROPS kind=pine_snow from=2921 to=3108 side=both every=12 offset=5 jitter=4 seed=119
PROPS kind=snow_cabin from=3110 to=3292 side=both every=20 offset=6 jitter=3 seed=120
PROPS kind=pine_snow from=3373 to=3630 side=both every=13 offset=5 jitter=4 seed=122
PROPS kind=snow_cabin from=3690 to=3830 side=both every=18 offset=6 seed=123
# landmarks: start-gate fairy lights, the gondola line down the mountain, four aurora curtains in the sky, the glacier
# hairpin crystals, the gully's crystal arches, ski-jump lights, the frozen-lake igloo, the ski lodge, the chapel and
# the finish lights
PROP kind=fairy_lights at=(20.0,-0.3,0.0) yaw=-90 scale=1
PROP kind=fairy_lights at=(56.0,-0.3,0.0) yaw=-90 scale=1
PROP kind=fairy_lights at=(110.0,-0.3,0.0) yaw=-90 scale=1
PROP kind=gondola_pylon at=(30.0,-0.3,28.0) yaw=90 scale=1
PROP kind=gondola_pylon at=(337.6,-20.7,95.8) yaw=65 scale=1
PROP kind=gondola_pylon at=(805.4,-60.5,-252.6) yaw=147 scale=1
PROP kind=gondola_pylon at=(649.6,-100.3,-545.3) yaw=-177 scale=1
PROP kind=aurora_ribbon at=(186.3,-24.8,292.1) yaw=166 scale=1.4
PROP kind=aurora_ribbon at=(583.1,-95.9,-138.5) yaw=145 scale=1.5
PROP kind=aurora_ribbon at=(401.5,-112.0,-831.1) yaw=20 scale=1.4
PROP kind=aurora_ribbon at=(229.6,-122.3,123.3) yaw=165 scale=1.3
PROP kind=ice_spire at=(894.9,-66.3,-328.1) yaw=-34 scale=1.3
