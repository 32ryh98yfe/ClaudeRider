# Snowglobe Halfpipe / 스노글로브 하프파이프 — Frostbyte Glacier, D2, 3 × 1300 m, item★ (11-track-spec §12.5).
# Bright overcast under the snow-globe dome: the penguin-village straight, the igloo corner, the halfpipe run,
# the crystal-cave tunnel and its S-bends, the ice-rink sweeper (ice 0.75), the sled run, the snowman S and the
# snow-fort corner home. Snow shoulders (0.90 grip / ×0.95) mark the off-road.
@signature halfpipe, surfaces, hazard:traffic
TRACK snowglobe_halfpipe name="Snowglobe Halfpipe" theme=frostbyte_glacier diff=2 laps=3 topo=circuit
DEFAULTS w=17 surf=asphalt wall=barrier:1.1 shoulder=2 shoulderSurf=snow blend=22
START pos=(0,0,0) hdg=0
GRID rows=4 cols=2 pitch=7 stagger=3.5 d=4
S 110                                     @village       # penguin-village straight; pads +90/+130
C R140 12 R ; C R140 12 L                 @village_s     # gentle S between the igloos
C R30 80 L bank=8                         @igloo         # igloo corner (V19)
S 38                                      @hp_entry
S 120 prof=hp60 wall=rock:1.6             @halfpipe      # hp60 halfpipe: 22.1 m footprint, 60° walls, free line choice
S 14 wall=barrier:1.1                     @hp_runout
C R45 50 L bank=4 w=17                    @hp_exit
S ?b=52 wall=rock:2.5                     @crystal_cave  # crystal-cave tunnel (arches)
WIGGLE R40 40/95/30 R bank=5 wall=barrier:1.1:soft @cave_s    # cave S-bends (snow-padded barriers)
C R140 15 R dy=1 wall=barrier:1.1 ; C R140 15 L dy=1       @glacier       # item row
C R25 150 L bank=10 surf=ice w=18         @rink          # ice-rink sweeper, ice 0.75 (V19)
C R60 20 R bank=-4 surf=asphalt w=17      @rink_exit
C R60 55 R bank=-4 dy=-2                  @sled_bend
WIGGLE R60 40/60/30 L bank=3              @sled_s
WIGGLE R35 30/70/25 L bank=6 wall=barrier:1.1:soft @snowman_s     # (V19) snow-padded
S ?c=44 wall=barrier:1.1                  @snowman_lane  # penguin sleds (cosmetic)
C R35 90 L bank=7                         @snow_fort     # (V19)
C R50 45 L bank=4                         @final_bend
S ?a=129                                  @run_in
CLOSE solve=[?a,?b,?c] length=1300
LINE start at=0
ITEMS at=140,290,460,640,880,1060 n=5
PAD at=50,100 d=0 len=6 w=4
KEYS 200,390,560,780,1000,1180
# penguin sled trains on the run-in's right lane (clear of the start grid and every item row)
HAZ traffic sleds at=@run_in+5 to=@run_in+70 lanes=[(d 5, speed 8, count 2, spacing 32)] prop=hazard_sled_train
# ice on the inside of each cave S-bend, and the whole rink sweeper is ice (0.75)
ZONE surface from=@cave_s+4 to=@cave_s+26 d=[1,8] surf=ice
ZONE surface from=@cave_s+34 to=@cave_s+88 d=[-8,-1] surf=ice
ZONE surface from=@cave_s+96 to=@cave_s+114 d=[1,8] surf=ice

# ---- look & dressing (Frostbyte Glacier kit; art bible: bright overcast over the penguin village) ----
# 2026-10 stylized pass (docs/design/34-stylized-pass.md, render-only: the .ctrk is unchanged): matte white-blue snow
# (never clipped), a cool neutral road, red/white kerbs, white-and-navy resort barriers; the village straight gets a
# snowy grandstand, penguin crowds, sponsor boards, lamps and flags; the whole lap gets snow tufts, frost sprigs, snowy
# junipers, snow-capped boulders, big snow firs and two layers of far pine lines. Wide props are fitted so no
# footprint reaches into any road band (scratch fitrows).
THEME frostbyte_glacier sky=overcast time=13:00 scatter=tree_pine_snow,tree_pine_snow,tree_round_big,bush_round,bush_round,rock_cluster,snowbank,tree_birch,serac,flower_patch density=36 hills=8 fogNear=240 fogFar=1400
PROPS kind=penguin from=5 to=108 side=both every=9 offset=2 jitter=2 scale=0.9-1.3 seed=82
PROPS kind=ice_spire from=424 to=606 side=both every=8 offset=2.4 jitter=0.6 scale=0.8-1.1 seed=88
PROPS kind=rink_boards from=682 to=745 side=R every=5.5 offset=0.4 scale=1-1 seed=90
PROPS kind=penguin from=684 to=744 side=L every=8 offset=3 jitter=3 seed=91
PROPS kind=snowman from=962 to=1036 side=R every=22 offset=5 seed=94
# village straight: grandstand on the right (clear of the pads at 50 / 100), penguin crowds and sponsor boards on the
# left (in front of the globe), lamps both sides, flags; the grid (run-in, behind the line) gets boards and crowds
PROPS kind=grandstand from=72 to=73 side=R every=100 offset=4.5 seed=201
PROPS kind=ad_board_a from=4 to=135 side=L every=24 offset=0.4 seed=202
PROPS kind=ad_board_c from=12 to=135 side=L every=24 offset=0.4 seed=203
PROPS kind=ad_board_c from=20 to=135 side=L every=24 offset=0.4 seed=204
PROPS kind=flag_pole from=22 to=70 side=L every=6 offset=2.6 seed=205
PROPS kind=spectators from=88 to=135 side=L every=24 offset=2.4 jitter=1 seed=206
PROPS kind=lamp_post from=2 to=138 side=both every=20 offset=1.4 seed=207
PROPS kind=ad_board_b from=1252 to=1299 side=R every=16 offset=0.4 seed=208
PROPS kind=ad_board_b_l from=1252 to=1299 side=L every=16 offset=0.4 seed=213
PROPS kind=ad_board_a from=1260 to=1299 side=both every=16 offset=0.4 seed=209
PROPS kind=spectators from=1256 to=1299 side=both every=16 offset=1.8 jitter=1 seed=210
# igloo corner (T1, a left-hander): tyre wall and chevron boards on the outside
PROPS kind=tyre_wall from=171 to=208 side=R every=1.3 offset=0.6 seed=211
PROPS kind=ad_board_b from=173 to=206 side=R every=10 offset=2.4 scale=1.4-1.4 seed=212
# ground cover over the whole lap: snow tufts at the barrier, frost sprigs, snowy junipers and boulders behind it
PROPS kind=grass_tuft side=both every=1 offset=0.3 jitter=8 scale=1.0-1.8 seed=221
PROPS kind=grass_tuft from=0.5 side=both every=2 offset=2 jitter=14 scale=0.8-1.4 seed=222
PROPS kind=flower_patch side=both every=5 offset=0.8 jitter=9 scale=0.8-1.3 seed=223
PROPS kind=bush_round side=both every=11 offset=3 jitter=9 scale=0.7-1.3 seed=224
PROPS kind=rock_cluster side=both every=23 offset=4 jitter=12 scale=0.6-1.4 seed=225
# ---- fitted rows (village, pines, birches, banks, seracs, big firs, far pine lines): every footprint, over the
# whole jitter band at the largest scale, stays clear of every road band
# penguin village: igloos (none behind the grandstand)
PROPS kind=igloo from=5 to=41 side=R every=18 offset=6 jitter=3 seed=81
PROPS kind=igloo from=95 to=95 side=R every=18 offset=6 jitter=3 seed=82
PROPS kind=snow_cabin from=112 to=160 side=L every=16 offset=6 seed=83
PROPS kind=snow_cabin from=1152 to=1224 side=R every=18 offset=6 jitter=2 seed=96
# snow pines, birches, seracs and snowbanks along the lap
PROPS kind=tree_pine_snow from=112 to=200 side=R every=11 offset=5 jitter=4 scale=0.85-1.15 seed=84
PROPS kind=tree_pine_snow from=370 to=414 side=L every=11 offset=5 jitter=4 scale=0.85-1.15 seed=85
PROPS kind=tree_pine_snow from=370 to=414 side=R every=11 offset=5 jitter=4 scale=0.85-1.15 seed=86
PROPS kind=tree_pine_snow from=747 to=824 side=L every=11 offset=5 jitter=4 scale=0.85-1.15 seed=87
PROPS kind=tree_pine_snow from=747 to=824 side=R every=11 offset=5 jitter=4 scale=0.85-1.15 seed=88
PROPS kind=tree_pine_snow from=1152 to=1295 side=L every=11 offset=5 jitter=4 scale=0.85-1.15 seed=89
PROPS kind=tree_birch from=826 to=958 side=L every=12 offset=5 jitter=4 scale=0.85-1.15 seed=93
PROPS kind=tree_birch from=826 to=958 side=R every=12 offset=5 jitter=4 scale=0.85-1.15 seed=94
PROPS kind=snowbank from=212 to=366 side=L every=14 offset=9 jitter=2 scale=0.85-1.15 seed=85
PROPS kind=snowbank from=212 to=366 side=R every=14 offset=9 jitter=2 scale=0.85-1.15 seed=86
PROPS kind=snowbank from=1097 to=1139 side=L every=14 offset=9 jitter=2 scale=0.85-1.15 seed=87
PROPS kind=serac from=250 to=346 side=L every=24 offset=8 jitter=6 scale=0.85-1.15 seed=86
PROPS kind=serac from=250 to=346 side=R every=24 offset=8 jitter=6 scale=0.85-1.15 seed=87
PROPS kind=serac from=608 to=680 side=L every=24 offset=8 jitter=6 scale=0.85-1.15 seed=88
PROPS kind=serac from=608 to=680 side=R every=24 offset=8 jitter=6 scale=0.85-1.15 seed=89
# big snow firs behind the barrier (none behind the grandstand or the grid)
PROPS kind=tree_round_big from=95 to=656 side=L every=17 offset=14 jitter=18 scale=0.8-1.3 seed=101
PROPS kind=tree_round_big from=707 to=724 side=L every=17 offset=14 jitter=18 scale=0.8-1.3 seed=102
PROPS kind=tree_round_big from=758 to=1234 side=L every=17 offset=14 jitter=18 scale=0.8-1.3 seed=103
PROPS kind=tree_round_big from=95 to=1234 side=R every=17 offset=14 jitter=18 scale=0.8-1.3 seed=104
PROPS kind=tree_round_big from=2 to=19 side=R every=17 offset=14 jitter=18 scale=0.8-1.3 seed=105
