# Snowglobe Halfpipe / 스노글로브 하프파이프 — Frostbyte Glacier, D2, 3 × 1300 m, item★ (11-track-spec §12.5).
# Bright overcast under the snow-globe dome: the penguin-village straight, the igloo corner, the halfpipe run,
# the crystal-cave tunnel and its S-bends, the ice-rink sweeper (ice 0.75), the sled run, the snowman S and the
# snow-fort corner home. Snow shoulders (0.90 grip / ×0.95) mark the off-road.
@signature halfpipe, surfaces
@fallback hazard:traffic -> "cosmetic penguin sleds beside the snowman lane" when=F5
TRACK snowglobe_halfpipe name="Snowglobe Halfpipe" theme=frostbyte_glacier diff=2 laps=3 topo=circuit
DEFAULTS w=17 surf=asphalt wall=barrier:1.1 shoulder=2 shoulderSurf=snow blend=22
START pos=(0,0,0) hdg=0
GRID rows=4 cols=2 pitch=7 stagger=3.5 d=4
S 110                                     @village       # penguin-village straight; pads +90/+130
C R140 12 R ; C R140 12 L                 @village_s     # gentle S between the igloos
C R30 80 L bank=8                         @igloo         # igloo corner (V19)
S 38                                      @hp_entry
S 120 prof=hp60 wall=rock:1.6             @halfpipe      # hp60 halfpipe: 22.1 m footprint, 60° walls, free line choice
S 14 wall=barrier:1.1                     @hp_runout
C R45 50 L bank=4 w=17                    @hp_exit
S ?b=52 wall=rock:2.5                     @crystal_cave  # crystal-cave tunnel (arches)
WIGGLE R40 40/95/30 R bank=5 wall=barrier:1.1 @cave_s    # cave S-bends
C R140 15 R dy=1 ; C R140 15 L dy=1       @glacier       # item row
C R25 150 L bank=10 surf=ice w=18         @rink          # ice-rink sweeper, ice 0.75 (V19)
C R60 20 R bank=-4 surf=asphalt w=17      @rink_exit
C R60 55 R bank=-4 dy=-2                  @sled_bend
WIGGLE R60 40/60/30 L bank=3              @sled_s
WIGGLE R35 30/70/25 L bank=6              @snowman_s     # (V19)
S ?c=44                                   @snowman_lane  # penguin sleds (cosmetic)
C R35 90 L bank=7                         @snow_fort     # (V19)
C R50 45 L bank=4                         @final_bend
S ?a=129                                  @run_in
CLOSE solve=[?a,?b,?c] length=1300
LINE start at=0
ITEMS at=140,290,460,640,880,1060 n=5
PAD at=50,100 d=0 len=6 w=4
KEYS 200,390,560,780,1000,1180
# ice on the inside of each cave S-bend, and the whole rink sweeper is ice (0.75)
ZONE surface from=@cave_s+4 to=@cave_s+26 d=[1,8] surf=ice
ZONE surface from=@cave_s+34 to=@cave_s+88 d=[-8,-1] surf=ice
ZONE surface from=@cave_s+96 to=@cave_s+114 d=[1,8] surf=ice
