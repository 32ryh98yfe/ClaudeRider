# Magma Switchback — Ember Mine D5 (speed). From the basalt plateau a 540° helix corkscrews down beside the lava lake,
# the road ducks under the plateau, threads the geyser field and the ore-rail corner, hops the lava channel and
# climbs back up through the basalt chicane and the twin R12 switchbacks.
@signature helix, stacked, rail, jump, ledge, hazard:geyser, conveyor
TRACK magma_switchback name="Magma Switchback" theme=ember_mine diff=5 laps=2 topo=circuit
DEFAULTS w=12 surf=basalt wall=rock:1.5 shoulder=0 shoulderSurf=gravel blend=16
START pos=(0,0,0) hdg=0
GRID rows=4 cols=2 pitch=6.5 stagger=3.2 d=3
S 70 w=14                                   @plateau
C R30 60 R w=12 bank=-6                     @plateau_1
S 20
C R26 120 L bank=8                          @plateau_2
S 30 dy=-1.5                                @helix_in
C R28 540 L dy=-14 bank=12                  @helix
S 30 dy=-2 w=12                             @under_plateau
C R45 54 R bank=-5
S 12
WIGGLE R28 50/100/50 L wall=rock:1.5:soft      @north_run
S ?a
WIGGLE R30 50/100/50 R wall=rock:1.5:soft      @geyser_field
S 24                                        @geyser_gap
WIGGLE R30 50/100/50 R wall=rock:1.5:soft
S 15                                        @rail_corner_in
C R35 120 L bank=6 wallL=rock:0.7 wallR=rock:1.5 @rail_corner
J ramp=28@8 gap=14 drop=4 land=42 wland=14 vmin=25 vmax=46 w=14 wall=rock:1.5 @lava_jump  # ramp 28 / land 42 (was 30 / 40, same 84 m): a 52 m/s tap-boost flight lands 49.5 m out, inside V11's 16–51 m
C R40 54 L w=12 bank=5
S ?b dy=1.5                                 @conveyors
CHICANE R22 55/110/55 L w=12                @basalt_chicane
S 20
C R14 180 R bank=-10                        @switchback_1
WIGGLE R60 25/50/25 R dy=6 w=12
C R14 180 L w=12 bank=10                    @switchback_2
WIGGLE R60 25/50/25 L dy=7 w=12
C R30 90 L bank=6                           @climb
S ?c
WIGGLE R50 40/80/40 L dy=7
S 30
C R30 90 R w=13 bank=-6                     @plateau_return
CLOSE solve=[?a,?b,?c] length=1850
LINE start at=40
# the obsidian ledge: an 8.5 m risk line along the lava channel, cutting the first geyser-field wiggle, open lava edge
BRANCH ledge from=@geyser_field to=@geyser_gap+22 kind=risk aiMin=0.9 w=8.5 wall=rock:0.6 gore=none surf=obsidian kill=lava {
  C R50 20 L ; S ?x wallL=none:0:ledgeKill ; C R80 40 R wallL=rock:0.6 ; S ?y wallL=rock:0.6 ; C R50 20 L
}
PAD at=@under_plateau d=0 len=6 w=4
PAD at=@lava_jump+1 d=0 len=6 w=4
# three geysers in the geyser field, staggered so there is always a way through
HAZ geyser g1 at=@geyser_field+30 d=+2 r=3 period=3.6 on=0-1.0 tele=0.8 offset=0.0
HAZ geyser g2 at=@geyser_field+95 d=-2 r=3 period=3.6 on=0-1.0 tele=0.8 offset=1.2
HAZ geyser g3 at=@geyser_gap+70 d=+2 r=3 period=3.6 on=0-1.0 tele=0.8 offset=2.4
# the ore rail over the lava lip on the inside of the corner, ending tangent to the jump ramp
RAIL ore host=main from=@rail_corner_in+2 to=@lava_jump+6 d=[@rail_corner_in+2:-2,@rail_corner+15:-8,@rail_corner+58:-8,@lava_jump+6:-1] h=1.0
     capture=(dMax 2.0, hdg 25, vMin 15) speed=(min 38, accel 3, max 42) gauge=0.30/s
ITEMS at=190,488,1123,1334,1496,1788 n=5
KEYS 190,480,1080,1180,1340,1500,1640,1790
ZONE conveyor from=@conveyors+10 to=@conveyors+75 d=[0,6] mul=1.15
ZONE conveyor from=@conveyors+10 to=@conveyors+75 d=[-6,0] mul=0.85
# --- dressing: the lava pit inside the helix, pit-floor lava beside the geyser field and the lava-edge corner,
# dormant vents, obsidian, lanterns, the cave roof (rows start beside the road and sit on the terrain)
PROPS kind=helix_pillar from=@helix+130 to=@helix+262 side=L every=11 offset=1.4
PROPS kind=lava_lake from=@helix+134 to=@helix+134 side=L every=100 offset=22 scale=1-1
PROPS kind=lava_rim from=@helix+134 to=@helix+134 side=L every=100 offset=22 scale=1-1
PROPS kind=lava_pit from=@geyser_field+40 to=@geyser_field+40 side=R every=100 offset=30
PROPS kind=lava_pit from=@rail_corner+35 to=@rail_corner+35 side=L every=100 offset=26
PROPS kind=geyser_vent from=@geyser_field to=@rail_corner_in side=both every=31 offset=2.2
PROPS kind=obsidian from=@basalt_chicane to=@climb side=both every=29 offset=3
PROPS kind=basalt_column from=@conveyors to=@climb side=both every=57 offset=9
PROPS kind=lava_crack from=@switchback_1 to=@climb side=both every=37 offset=5
# review round: lava you can see from the line. Glowing cracks beside the road from the line to the first switchback,
# a lava pool on the outside of T1, glowing seams at the foot of the start-straight walls, and lanterns every 20 m
# through the helix and under the plateau (the stretch that read near-black)
PROPS kind=lava_crack from=@plateau+40 to=@switchback_1 side=both every=20 offset=4 jitter=2 seed=190
PROPS kind=lava_pool from=@plateau_1+8 to=@plateau_1+8 side=L every=100 offset=5.5 scale=1-1 seed=191
PROPS kind=lava_seam from=@plateau to=@plateau+70 side=both every=4.2 offset=0.1 scale=1-1 seed=192
PROPS kind=lantern from=@helix_in to=@north_run side=both every=20 offset=0.2 seed=193
PROPS kind=lantern along=main side=both every=28 offset=0.22
PROPS kind=cave_roof along=main side=R every=46 offset=3 scale=0.9-1.1
# ---- stylized dressing pass (2026-10, docs/design/34-stylized-pass.md; render-only, the .ctrk is unchanged) ----
# the plateau straight (the line sits 40 m in): a miners' scaffold stand, crowd, mine signs; tyre wall round T1 (R, so
# its outside is the left)
# (the stand sits just past the line: before it, the start-wide camera looked straight down onto its roof)
PROPS kind=grandstand from=@plateau+54 to=@plateau+55 side=R every=100 offset=5.5 seed=60
PROPS kind=ad_board_a from=@plateau+4 to=@plateau+68 side=L every=24 offset=0.4 seed=61
# (no chevron ad_board_b on the left: side=L rows turn props 180°, so its arrows would point back down the straight;
# ad_board_b_l is the left-row chevron board, used round T1 below)
PROPS kind=ad_board_a from=@plateau+12 to=@plateau+68 side=L every=24 offset=0.4 seed=62
PROPS kind=ad_board_c from=@plateau+20 to=@plateau+68 side=L every=24 offset=0.4 seed=63
PROPS kind=spectators from=@plateau+14 to=@plateau+30 side=R every=8 offset=2.4 jitter=1 seed=64
PROPS kind=flag_pole from=@plateau+2 to=@plateau+10 side=R every=4 offset=2.6 seed=65
PROPS kind=tyre_wall from=@plateau_1+1 to=@plateau_1+30 side=L every=1.3 offset=0.6 seed=66
# final pass: chevrons on the outside of T1 (plateau_1 is a right-hander, so the outside is the left); only the first
# 10 m: past plateau_1+12 the ground beside the road drops into the pit, and boards there stood 5-15 m below the road
PROPS kind=ad_board_b_l from=@plateau_1+2 to=@plateau_1+10 side=L every=4 offset=2.4 seed=68
PROPS kind=lamp_post along=main side=both every=32 offset=1.6 seed=67
# floor cover, rubble, basalt, stalagmite columns and the far stalagmite forest round the lap (none on the lava lake)
# (left of the helix is the lava lake, left of the rail corner and right of the geyser field are lava pits)
# (the switchback stacks the road: rows that reach out from one stretch could stand on, or overhang, another stretch
# above, below or across a hairpin, so the floor cover, rubble, columns, clutter and the far forest are split round those
# stretches; generated against the baked frame, ranges are DSL distances: baked s + 40)
PROPS kind=bush_round along=841-1148 side=R every=11 offset=3 jitter=9 scale=0.7-1.3 seed=72
PROPS kind=bush_round along=1161-1213 side=R every=11 offset=3 jitter=9 scale=0.7-1.3 seed=172
PROPS kind=bush_round along=1239-1311 side=R every=11 offset=3 jitter=9 scale=0.7-1.3 seed=272
