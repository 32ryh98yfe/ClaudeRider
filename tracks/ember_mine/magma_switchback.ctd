PROPS kind=pipe_run from=@conveyors to=@basalt_chicane side=R every=8.6 offset=0.9 scale=1-1 seed=82
# the start zone (line ±10 m excludes PROPS rows): hand-placed from the baked frame (offset from the road edge)
PROP kind=grass_patch at=(34.0,-0.2,-7.2) yaw=270 scale=1
PROP kind=grass_patch at=(46.0,-0.2,-7.2) yaw=270 scale=1
PROP kind=grass_patch at=(34.0,-0.2,7.2) yaw=90 scale=1
