# Magma Switchback — Ember Mine D5 (speed). From the basalt plateau a 540° helix corkscrews down beside the lava lake,
# the road ducks under the plateau, threads the geyser field and the ore-rail corner, hops the lava channel and
# climbs back up through the basalt chicane and the twin R12 switchbacks.
# @signature helix, stacked, rail, jump, ledge, hazard:geyser, conveyor
# @fallback helix -> "3 x C R16 180 descending switchbacks, dy -4.7 each" when=F6   (not taken: C+dy stacks cleanly)
# @fallback rail -> "lava-edge corner at d -6, no capture" when=F4
# @fallback jump -> "jump-pad hop over the lava channel (surf=jump_pad lip, no gap)" when=F2
# @fallback ledge -> "ledge branch omitted (no BRANCH in the M1 DSL)" when=F1
# @fallback hazard:geyser -> "static vents (cosmetic)" when=F5
# @fallback conveyor -> "belts drawn on the split lanes, no speed change (ZONE conveyor)" when=F1
TRACK magma_switchback name="Magma Switchback" theme=ember_mine diff=5 laps=2 topo=circuit
DEFAULTS w=12 surf=basalt wall=rock:1.5 shoulder=0 shoulderSurf=gravel blend=16
START pos=(0,0,0) hdg=0
GRID rows=4 cols=2 pitch=6.5 stagger=3.2 d=3
S 70 w=14                                   @plateau
C R30 60 R w=12 bank=-6                     @plateau_1
S 20
C R26 120 L bank=8                          @plateau_2
S 30 dy=-1.5                                @helix_in
C R28 540 L dy=-14 bank=12                  @helix
S 30 dy=-2 w=12                             @under_plateau
C R45 54 R bank=-5
S 12
WIGGLE R28 50/100/50 L                      @north_run
S ?a
WIGGLE R30 50/100/50 R                      @geyser_field
S 20
WIGGLE R30 50/100/50 R
S 15                                        @rail_corner_in
C R35 120 L bank=6 wallL=rock:0.7 wallR=rock:1.5 @rail_corner
S 30 w=14 wall=rock:1.5                     @jump_ramp
S 4 surf=jump_pad                           @lava_lip
S 50 dy=-4 surf=basalt                      @lava_landing
C R40 54 L w=12 bank=5
S ?b dy=1.5                                 @conveyors
CHICANE R22 55/110/55 L w=12                @basalt_chicane
S 20
C R14 180 R bank=-10                        @switchback_1
WIGGLE R60 25/50/25 R dy=6 w=12
C R14 180 L w=12 bank=10                    @switchback_2
WIGGLE R60 25/50/25 L dy=7 w=12
C R30 90 L bank=6                           @climb
S ?c
WIGGLE R50 40/80/40 L dy=7
S 30
C R30 90 R w=13 bank=-6                     @plateau_return
CLOSE solve=[?a,?b,?c] length=1850
LINE start at=40
PAD at=468,1072,1778 d=0 len=6 w=4
PAD at=1122 d=3 len=6 w=4
ITEMS at=180,485,657,1140,1390,1540,1792 n=5
KEYS 190,480,660,940,1140,1340,1540,1740
# --- dressing (PROPS along= is main-line s, i.e. DSL s - 40): basalt ledges, the lava pit inside the helix,
# pit-floor lava beside the geyser field and the rail corner, vents, obsidian, lanterns, the cave roof
PROPS kind=rock_bank along=0-38 side=both every=7 offset=0
PROPS kind=rock_bank along=84-124 side=both every=7 offset=0
PROPS kind=rock_bank along=290-1550 side=both every=7 offset=0
PROPS kind=rock_bank along=1586-1734 side=both every=7 offset=0
PROPS kind=rock_bank along=1780-1850 side=both every=7 offset=0
PROPS kind=helix_pillar along=292-428 side=L every=11 offset=1.4
PROPS kind=lava_lake along=300-300 side=L every=100 offset=22
PROPS kind=lava_rim along=300-300 side=L every=100 offset=22
PROPS kind=lava_pit along=660-660 side=R every=100 offset=30
PROPS kind=lava_pit along=800-800 side=L every=100 offset=30
PROPS kind=lava_pit along=900-900 side=L every=100 offset=28
PROPS kind=lava_pit along=500-500 side=R every=100 offset=34
PROPS kind=geyser_vent along=560-808 side=both every=31 offset=2.2
PROPS kind=ore_rail along=866-936 side=L every=8 offset=2.4
PROPS kind=obsidian along=1106-1520 side=both every=29 offset=3
PROPS kind=basalt_column along=1100-1500 side=both every=57 offset=9
PROPS kind=lantern along=0-1850 side=both every=28 offset=0.22
PROPS kind=cave_roof along=0-1850 side=L every=46 offset=-6
THEME scatter=basalt_column,stalagmite,obsidian,basalt_column density=9 hills=6 sky=underground
