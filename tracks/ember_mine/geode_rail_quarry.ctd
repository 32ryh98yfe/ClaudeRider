# Geode Rail Quarry — Ember Mine D3 (both modes). A crystal cavern quarry: timber trestles over the pit, two ore-rail
# lines climbing to the tunnel level, a 300° geode spiral down into the amethyst chamber and a conveyor run past the
# headframe yard.
@signature rail, conveyor, hazard:traffic
@fallback hazard:traffic -> "cart tunnel always open" when=F5
@fallback branch -> "cart_tunnel omitted (no BRANCH in the M1 DSL): main line only" when=F1
TRACK geode_rail_quarry name="Geode Rail Quarry" theme=ember_mine diff=3 laps=3 topo=circuit
DEFAULTS w=15 surf=stone wall=rock:1.4 shoulder=0 shoulderSurf=gravel blend=16
START pos=(0,0,0) hdg=0
GRID rows=4 cols=2 pitch=7 stagger=3.5 d=3.5
S ?a=75                                    @cavern_straight
C R20 90 L bank=6 dy=1.5                   @cavern_corner
S 12 dy=1
WIGGLE R20 40/80/40 R w=15 wall=fence:1.2 dy=5.5  @trestle_s
WIGGLE R144 9/18/9 L surf=wood w=14 bank=3 dy=1                             @ore_rail_1
C R26 120 L surf=stone w=14 wall=rock:1.4 bank=5 @rail_exit
S ?b=60                                    @tunnel_split
C R24 300 R dy=-9 bank=-6 w=16                @geode_spiral
S 70 w=15                                  @geode_chamber
C R16 150 L w=15 bank=6                    @amethyst_hairpin
WIGGLE R22 40/80/40 L w=16                 @crystal_s
C R35 95 L bank=5                   @lantern_corner
S 20                                       @cart_crossing
S 58 surf=conveyor_fwd                @conveyor_lift
S 80 surf=wood wall=fence:1.2         @ore_rail_2
C R30 120 L surf=stone w=14 wall=rock:1.4 bank=6 @headframe_hairpin
C R40 45 R bank=-4 w=15                  @headframe_kink
WIGGLE R60 30/60/30 R                      @ore_yard_s
C R90 80 L bank=4                  @winch_corner
S ?c=240                                   @winch_run
C R80 50 L bank=3                   @headframe_exit
S 87                                       @to_line
CLOSE solve=[?a,?b,?c] length=1375
LINE start at=0
ITEMS at=75,505,760,1010,1200 n=5
PAD at=1292,1335,704,742 d=0 len=6 w=4
ZONE conveyor from=@conveyor_lift to=@ore_rail_2 d=[-7.5,7.5] mul=1.15
# two ore rails along the left lane: grind them for speed and +0.30/s gauge
RAIL ore1 host=main from=@ore_rail_1-4 to=@ore_rail_1+86 d=[@ore_rail_1-4:-2,@ore_rail_1+14:-4,@ore_rail_1+70:-4,@ore_rail_1+86:-2] h=1.0
     capture=(dMax 2.0, hdg 25, vMin 15) speed=(min 38, accel 4, max 44) gauge=0.30/s
RAIL ore2 host=main from=@ore_rail_2 to=@ore_rail_2+74 d=[@ore_rail_2:-2,@ore_rail_2+14:-4.5,@ore_rail_2+60:-4.5,@ore_rail_2+74:-2] h=1.0
     capture=(dMax 2.0, hdg 25, vMin 15) speed=(min 38, accel 4, max 44) gauge=0.30/s
KEYS 150,300,505,700,900,1100,1300
# --- dressing (rows start beside the road and sit on the terrain; arches span from the right post: offset 9.3 - w/2)
PROPS kind=timber_arch from=@cavern_straight+25 to=@cavern_straight+85 side=R every=30 offset=1.8 scale=1-1
PROPS kind=timber_arch from=@to_line+10 to=@to_line+80 side=R every=35 offset=1.8 scale=1-1
PROPS kind=timber_arch from=@ore_rail_2+5 to=@ore_rail_2+75 side=R every=35 offset=1.8 scale=1-1
PROPS kind=lantern along=main side=both every=26 offset=0.22
PROPS kind=geode_cyan from=@cavern_straight+20 to=@geode_spiral side=both every=41 offset=4
PROPS kind=geode_violet from=@geode_spiral to=@cart_crossing side=both every=33 offset=4
PROPS kind=geode_cyan from=@headframe_hairpin to=@to_line+80 side=both every=47 offset=4.2
PROPS kind=mine_cart from=@geode_chamber to=@lantern_corner side=R every=95 offset=5
PROPS kind=mine_cart from=@winch_corner to=@to_line side=L every=110 offset=5
PROPS kind=ore_pile from=@amethyst_hairpin to=@cart_crossing side=L every=70 offset=7
PROPS kind=ore_pile from=@ore_yard_s to=@headframe_exit side=R every=120 offset=8
PROPS kind=headframe from=@to_line+30 to=@to_line+30 side=L every=100 offset=34
PROPS kind=crystal_spire from=@geode_chamber+40 to=@geode_chamber+40 side=L every=100 offset=24
PROPS kind=crystal_spire from=@winch_corner+90 to=@winch_corner+90 side=R every=100 offset=30
PROPS kind=lava_pool from=@crystal_s+30 to=@crystal_s+30 side=L every=100 offset=14
PROPS kind=cave_roof along=main side=R every=46 offset=3 scale=0.9-1.1
# ---- stylized dressing pass (2026-10, docs/design/34-stylized-pass.md; render-only, the .ctrk is unchanged) ----
# the cavern straight: a miners' scaffold stand, a hard-hat crowd, mine signs, work lamps; tyre wall round T1
PROPS kind=grandstand from=@cavern_straight+40 to=@cavern_straight+41 side=L every=100 offset=5.5 seed=60
PROPS kind=ad_board_a from=@cavern_straight+14 to=@cavern_straight+94 side=R every=24 offset=0.4 seed=61
PROPS kind=ad_board_b from=@cavern_straight+22 to=@cavern_straight+94 side=R every=24 offset=0.4 seed=62
PROPS kind=ad_board_c from=@cavern_straight+60 to=@cavern_straight+94 side=L every=16 offset=0.4 seed=63
PROPS kind=spectators from=@cavern_straight+58 to=@cavern_straight+94 side=L every=12 offset=2.4 jitter=1 seed=64
PROPS kind=flag_pole from=@cavern_straight+14 to=@cavern_straight+26 side=L every=5 offset=2.6 seed=65
PROPS kind=tyre_wall from=@cavern_corner+1 to=@cavern_corner+42 side=R every=1.3 offset=0.6 seed=66
PROPS kind=lamp_post along=main side=both every=30 offset=1.6 seed=67
# floor cover, rubble, basalt, stalagmite columns and the far stalagmite forest round the lap
PROPS kind=grass_tuft side=both every=0.8 offset=0.2 jitter=8 scale=1.0-1.8 seed=70
PROPS kind=flower_patch side=both every=5 offset=0.8 jitter=9 scale=0.8-1.3 seed=71
PROPS kind=bush_round side=both every=11 offset=3 jitter=9 scale=0.7-1.3 seed=72
PROPS kind=rock_cluster side=both every=23 offset=4 jitter=12 scale=0.6-1.4 seed=73
PROPS kind=tree_round_big from=@cavern_straight to=@to_line+20 side=R every=17 offset=14 jitter=18 scale=0.8-1.3 seed=74
PROPS kind=tree_round_big from=@cavern_straight+60 to=@to_line+20 side=L every=17 offset=14 jitter=18 scale=0.8-1.3 seed=75
PROPS kind=tree_clump side=both every=26 offset=60 jitter=50 scale=0.9-1.4 seed=76
PROPS kind=tree_clump side=both every=34 offset=125 jitter=50 scale=1.0-1.6 seed=77
# mine clutter: supply piles, timber cribs and pipe runs along the walls
PROPS kind=crate_barrels side=both every=45 offset=3 jitter=4 seed=78
PROPS kind=timber_crib side=both every=70 offset=6 jitter=6 seed=79
PROPS kind=pipe_run from=@winch_corner to=@to_line side=R every=8.6 offset=0.9 scale=1-1 seed=80
PROPS kind=pipe_run from=@geode_chamber to=@amethyst_hairpin side=L every=8.6 offset=0.9 scale=1-1 seed=81
# the start zone (line ±10 m and the pads at 1292 / 1335 exclude PROPS rows from 1286 to 10): hand-placed from the
# baked frame (offset from the road edge)
PROP kind=grass_patch at=(-44.0,-0.2,-7.7) yaw=270 scale=1
PROP kind=grass_patch at=(-32.0,-0.2,-7.7) yaw=270 scale=1
PROP kind=grass_patch at=(-20.0,-0.2,-7.7) yaw=270 scale=1
PROP kind=grass_patch at=(-8.0,-0.2,-7.7) yaw=270 scale=1
PROP kind=grass_patch at=(4.0,-0.2,-7.7) yaw=270 scale=1
PROP kind=grass_patch at=(-44.0,-0.2,7.7) yaw=90 scale=1
PROP kind=grass_patch at=(-32.0,-0.2,7.7) yaw=90 scale=1
PROP kind=grass_patch at=(-20.0,-0.2,7.7) yaw=90 scale=1
PROP kind=grass_patch at=(-8.0,-0.2,7.7) yaw=90 scale=1
PROP kind=grass_patch at=(4.0,-0.2,7.7) yaw=90 scale=1
PROP kind=grass_patch at=(-80.0,-0.2,-7.7) yaw=270 scale=1
PROP kind=grass_patch at=(-80.0,-0.2,7.7) yaw=90 scale=1
PROP kind=lamp_post at=(-40.0,-0.2,-9.1) yaw=270 scale=1
PROP kind=lamp_post at=(-40.0,-0.2,9.1) yaw=90 scale=1
PROP kind=lamp_post at=(-16.0,-0.2,-9.1) yaw=270 scale=1
PROP kind=lamp_post at=(-16.0,-0.2,9.1) yaw=90 scale=1
PROP kind=lamp_post at=(6.0,-0.2,-9.1) yaw=270 scale=1
PROP kind=lamp_post at=(6.0,-0.2,9.1) yaw=90 scale=1
PROP kind=ad_board_a at=(-36.0,-0.2,7.9) yaw=90 scale=1
PROP kind=ad_board_a at=(-4.0,-0.2,-7.9) yaw=270 scale=1
PROP kind=ad_board_b at=(-28.0,-0.2,7.9) yaw=90 scale=1
PROP kind=ad_board_b at=(-28.0,-0.2,-7.9) yaw=270 scale=1
PROP kind=ad_board_c at=(-12.0,-0.2,7.9) yaw=90 scale=1
PROP kind=ad_board_c at=(-44.0,-0.2,-7.9) yaw=270 scale=1
PROP kind=spectators at=(-24.0,-0.2,9.5) yaw=90 scale=1
PROP kind=spectators at=(-10.0,-0.2,-9.9) yaw=270 scale=1
PROP kind=crate_barrels at=(-34.0,-0.2,-11.0) yaw=270 scale=1
PROP kind=crate_barrels at=(2.0,-0.2,11.0) yaw=90 scale=1
PROP kind=flag_pole at=(-20.0,-0.2,-10.1) yaw=270 scale=1
PROP kind=flag_pole at=(-16.0,-0.2,-10.1) yaw=270 scale=1
THEME scatter=stalagmite,basalt_column,stalagmite,geode_violet,tree_round_big,rock_cluster,bush_round,crate_barrels,timber_crib density=34 hills=12 sky=underground fogNear=70 fogFar=520
