# Geode Rail Quarry — Ember Mine D3 (both modes). A crystal cavern quarry: timber trestles over the pit, two ore-rail
# lines climbing to the tunnel level, a 300° geode spiral down into the amethyst chamber and a conveyor run past the
# headframe yard.
@signature rail, conveyor, hazard:traffic
@fallback hazard:traffic -> "cart tunnel always open" when=F5
@fallback branch -> "cart_tunnel omitted (no BRANCH in the M1 DSL): main line only" when=F1
TRACK geode_rail_quarry name="Geode Rail Quarry" theme=ember_mine diff=3 laps=3 topo=circuit
DEFAULTS w=15 surf=stone wall=rock:1.4 shoulder=0 shoulderSurf=gravel blend=16
START pos=(0,0,0) hdg=0
GRID rows=4 cols=2 pitch=7 stagger=3.5 d=3.5
S ?a=75                                    @cavern_straight
C R20 90 L bank=6 dy=1.5                   @cavern_corner
S 12 dy=1
WIGGLE R20 40/80/40 R w=15 wall=fence:1.2 dy=5.5  @trestle_s
WIGGLE R144 9/18/9 L surf=wood w=14 bank=3 dy=1                             @ore_rail_1
C R26 120 L surf=stone w=14 wall=rock:1.4 bank=5 @rail_exit
S ?b=60                                    @tunnel_split
C R24 300 R dy=-9 bank=-6 w=16                @geode_spiral
S 70 w=15                                  @geode_chamber
C R16 150 L w=15 bank=6                    @amethyst_hairpin
WIGGLE R22 40/80/40 L w=16                 @crystal_s
C R35 95 L bank=5                   @lantern_corner
S 20                                       @cart_crossing
S 58 surf=conveyor_fwd                @conveyor_lift
S 80 surf=wood wall=fence:1.2         @ore_rail_2
C R30 120 L surf=stone w=14 wall=rock:1.4 bank=6 @headframe_hairpin
C R40 45 R bank=-4 w=15                  @headframe_kink
WIGGLE R60 30/60/30 R                      @ore_yard_s
C R90 80 L bank=4                  @winch_corner
S ?c=240                                   @winch_run
C R80 50 L bank=3                   @headframe_exit
S 87                                       @to_line
CLOSE solve=[?a,?b,?c] length=1375
LINE start at=0
ITEMS at=75,505,760,1010,1200 n=5
PAD at=1292,1335,704,742 d=0 len=6 w=4
ZONE conveyor from=@conveyor_lift to=@ore_rail_2 d=[-7.5,7.5] mul=1.15
# two ore rails along the left lane: grind them for speed and +0.30/s gauge
RAIL ore1 host=main from=@ore_rail_1-4 to=@ore_rail_1+86 d=[@ore_rail_1-4:-2,@ore_rail_1+14:-4,@ore_rail_1+70:-4,@ore_rail_1+86:-2] h=1.0
     capture=(dMax 2.0, hdg 25, vMin 15) speed=(min 38, accel 4, max 44) gauge=0.30/s
RAIL ore2 host=main from=@ore_rail_2 to=@ore_rail_2+74 d=[@ore_rail_2:-2,@ore_rail_2+14:-4.5,@ore_rail_2+60:-4.5,@ore_rail_2+74:-2] h=1.0
     capture=(dMax 2.0, hdg 25, vMin 15) speed=(min 38, accel 4, max 44) gauge=0.30/s
KEYS 150,300,505,700,900,1100,1300
# --- dressing (rows start beside the road and sit on the terrain; arches span from the right post: offset 9.3 - w/2)
PROPS kind=timber_arch from=@cavern_straight+25 to=@cavern_straight+85 side=R every=30 offset=1.8 scale=1-1
PROPS kind=timber_arch from=@to_line+10 to=@to_line+80 side=R every=35 offset=1.8 scale=1-1
PROPS kind=timber_arch from=@ore_rail_2+5 to=@ore_rail_2+75 side=R every=35 offset=1.8 scale=1-1
PROPS kind=lantern along=main side=both every=26 offset=0.22
PROPS kind=geode_cyan from=@cavern_straight+20 to=@geode_spiral side=both every=41 offset=4
PROPS kind=geode_violet from=@geode_spiral to=@cart_crossing side=both every=33 offset=4
PROPS kind=geode_cyan from=@headframe_hairpin to=@to_line+80 side=both every=47 offset=4.2
PROPS kind=mine_cart from=@geode_chamber to=@lantern_corner side=R every=95 offset=5
PROPS kind=mine_cart from=@winch_corner to=@to_line side=L every=110 offset=5
PROPS kind=ore_pile from=@amethyst_hairpin to=@cart_crossing side=L every=70 offset=7
PROPS kind=ore_pile from=@ore_yard_s to=@headframe_exit side=R every=120 offset=8
PROPS kind=headframe from=@to_line+30 to=@to_line+30 side=L every=100 offset=34
PROPS kind=crystal_spire from=@geode_chamber+40 to=@geode_chamber+40 side=L every=100 offset=24
PROPS kind=crystal_spire from=@winch_corner+90 to=@winch_corner+90 side=R every=100 offset=30
PROPS kind=lava_pool from=@crystal_s+30 to=@crystal_s+30 side=L every=100 offset=14
PROPS kind=cave_roof along=main side=R every=46 offset=3 scale=0.9-1.1
THEME scatter=stalagmite,basalt_column,stalagmite,geode_violet density=10 hills=12 sky=underground
