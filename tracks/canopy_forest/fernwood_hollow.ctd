# Fernwood Hollow — Canopy Forest D1 (item-built starter). A morning trail through giant trunks: the trunk corner,
# a hollow-log tunnel, fern S-bends, a log bridge over the creek, the long pond sweeper (or the twisty Mossy Bypass),
# a mushroom bounce in the meadow, the firefly corner, the glade, the root kink and the old oak.
@signature branch, pads, jump
TRACK fernwood_hollow name="Fernwood Hollow" theme=canopy_forest diff=1 laps=3 topo=circuit
DEFAULTS w=18 surf=asphalt wall=rock:1.2 shoulders=2.5:dirt blend=16
START pos=(0,0,0) hdg=0
GRID rows=4 cols=2 pitch=7 stagger=3.5 d=4
S ?a                                              @trail
C R40 104 L bank=5                                @trunk_corner
S 78 w=17 shoulders=1:dirt                        @log_tunnel
WIGGLE R60 40/79/50 R bank=3 w=18 shoulders=2.5:dirt   @fern_s
S ?b w=17 surf=wood wall=invisible:1.1 shoulders=0.5:dirt   @log_bridge
C R50 140 L bank=4 w=18 surf=asphalt wall=rock:1.2 shoulders=1:dirt   @pond_sweeper
WIGGLE R55 37/64/45 R bank=3 shoulders=2.5:dirt   @pond_s
S ?c                                              @mushroom_meadow
S 50                                              @mushroom_hop
C R55 84 L bank=5                                 @firefly_corner
S 59                                              @glade
C R70 45 R bank=-3                                @root_kink
C R50 106 L bank=5                                @old_oak
S 95                                              @home
CLOSE solve=[?a,?b,?c] length=1350
LINE start at=0

# Mossy Bypass (alt): forks off the log bridge, cuts inside the pond sweeper on mossy dirt past the pond and rejoins
# at the sweeper exit — two tight R25 corners instead of one long R50 sweep.
BRANCH mossy_bypass from=@pond_sweeper-30 to=@pond_s kind=alt aiMin=0.2 w=9 surf=dirt wall=rock:1.0 shoulders=0.5:grass {
  C R25 36 L ; S ?x ; C R25 104 L ; S ?y
}

# 6 rows ≈ L/250 (+1): trail, inside the hollow log, log bridge, mushroom meadow, glade, home straight
ITEMS at=@trail+108,@log_tunnel+45,@log_bridge+30,@mushroom_meadow+30,@glade+30,@home+40 n=5
PAD at=@trail+40,@trail+75 d=0 len=6 w=4
# the mushroom bounce: a coral jump pad between the giant toadstools (always lands on the road)
PAD at=@mushroom_hop+8 d=0 len=5 w=6 kind=jump
KEYS @trail+140,@log_tunnel+10,@fern_s+100,@pond_s+40,@mushroom_hop+40,@glade+20,@old_oak+20

# --- dressing: two rows of giant trunks + a forest wall behind; the tunnel, bridge and pond stay open
# (the left row starts after the log grandstand by the line, so the stand and the first corner stay readable)
PROPS kind=giant_trunk from=@trail to=@log_tunnel-8 side=R every=22 offset=7 jitter=5
PROPS kind=giant_trunk from=@trail+60 to=@log_tunnel-8 side=L every=22 offset=7 jitter=5 seed=60
PROPS kind=giant_trunk from=@fern_s+10 to=@log_bridge-10 side=both every=26 offset=8 jitter=6
PROPS kind=giant_trunk from=@pond_s+10 to=@mushroom_meadow side=both every=26 offset=8 jitter=5
PROPS kind=giant_trunk from=@firefly_corner to=@old_oak side=both every=24 offset=8 jitter=6
PROPS kind=giant_trunk from=@home to=@home+95 side=R every=22 offset=7 jitter=5
PROPS kind=giant_trunk from=@home to=@home+40 side=L every=22 offset=7 jitter=5 seed=61
PROPS kind=forest_wall along=main side=both every=36 offset=26 jitter=12
PROPS kind=grass_fern along=main side=both every=9 offset=1.0
PROPS kind=shrub along=main side=both every=29 offset=3.5 jitter=2
PROPS kind=mushroom_red from=@fern_s to=@log_bridge side=both every=23 offset=2
PROPS kind=rock_moss from=@fern_s+20 to=@log_bridge-20 side=both every=40 offset=5
PROPS kind=log_rail from=@log_bridge to=@log_bridge+101 side=both every=8 offset=0.3
PROPS kind=grass_fern along=mossy_bypass side=both every=6 offset=0.6
PROPS kind=mushroom_red along=mossy_bypass side=both every=17 offset=1.4
PROPS kind=rock_moss along=mossy_bypass side=L every=30 offset=4
PROPS kind=mushroom_giant from=@mushroom_meadow to=@mushroom_hop+45 side=both every=30 offset=7
PROPS kind=mushroom_red from=@mushroom_meadow to=@mushroom_hop+48 side=both every=14 offset=1.5
PROPS kind=firefly from=@firefly_corner to=@glade side=both every=18 offset=4
PROPS kind=stump from=@glade to=@root_kink side=both every=24 offset=4
PROPS kind=mossy_log from=@root_kink to=@old_oak side=both every=30 offset=5
PROP kind=hollow_log at=(177.2,-0.2,-87.5) yaw=-166.0
PROP kind=bridge_deck at=(127.8,-0.2,-335.1) yaw=-177.0
PROP kind=pond at=(71.5,-0.3,-371.9) yaw=0
PROP kind=old_oak at=(-106.2,-0.3,-41.3) yaw=37.9
# ---- stylized dressing pass (2026-10, docs/design/34-stylized-pass.md; render-only, the .ctrk is unchanged) ----------
# start straight: a log grandstand left of the line, lanterns, pennants, signboards behind the wall and woodland fans
PROPS kind=grandstand from=@trail+30 to=@trail+31 side=L every=100 offset=5.5 seed=70
PROPS kind=ad_board_a from=@trail+4 to=@trail+140 side=R every=24 offset=0.4 seed=71
PROPS kind=ad_board_c from=@trail+16 to=@trail+140 side=R every=24 offset=0.4 seed=72
PROPS kind=ad_board_b from=@home+10 to=@home+92 side=R every=24 offset=0.4 seed=73
PROPS kind=ad_board_c from=@trail+52 to=@trail+140 side=L every=30 offset=0.4 seed=74
PROPS kind=lamp_post from=@home+5 to=@trail+140 side=both every=20 offset=1.6 seed=75
PROPS kind=flag_pole from=@trail+46 to=@trail+90 side=L every=6 offset=2.6 seed=76
PROPS kind=spectators from=@trail+60 to=@trail+140 side=L every=22 offset=2.4 jitter=1 seed=77
PROPS kind=spectators from=@home+12 to=@home+90 side=R every=18 offset=2.4 jitter=1 seed=78
# the trunk corner (left-hander, outside on the right): log barrier at the wall, chevron boards above it
PROPS kind=tyre_wall from=@trunk_corner+2 to=@trunk_corner+70 side=R every=1.3 offset=0.6 seed=79
PROPS kind=ad_board_b from=@trunk_corner+4 to=@trunk_corner+66 side=R every=10 offset=2.4 seed=80
# ground cover at the wall foot round the whole lap (the log bridge stays open; the pond side of the sweeper stays bare)
PROPS kind=grass_tuft from=@pond_sweeper+4 to=@log_bridge-4 side=R every=0.9 offset=0.2 jitter=7 scale=1.0-1.7 seed=81
PROPS kind=grass_tuft from=@pond_s to=@log_bridge-4 side=L every=0.9 offset=0.2 jitter=7 scale=1.0-1.7 seed=82
PROPS kind=flower_patch from=@pond_sweeper+4 to=@log_bridge-4 side=R every=6 offset=0.8 jitter=9 scale=0.8-1.3 seed=83
PROPS kind=flower_patch from=@pond_s to=@log_bridge-4 side=L every=6 offset=0.8 jitter=9 scale=0.8-1.3 seed=84
PROPS kind=mushroom_patch from=@pond_s to=@log_bridge-4 side=both every=14 offset=0.6 jitter=5 scale=0.8-1.4 seed=85
# fern bushes and mossy rocks behind (not inside the hollow log, whose shell meets the ground 11.6 m out)
PROPS kind=bush_round from=@pond_s to=@log_tunnel-6 side=both every=10 offset=2.5 jitter=8 scale=0.7-1.3 seed=86
PROPS kind=bush_round from=@fern_s+6 to=@log_bridge-4 side=both every=10 offset=2.5 jitter=8 scale=0.7-1.3 seed=87
PROPS kind=rock_cluster from=@pond_s to=@log_tunnel-6 side=both every=21 offset=3.5 jitter=12 scale=0.6-1.4 seed=88
PROPS kind=rock_cluster from=@fern_s+6 to=@log_bridge-4 side=both every=21 offset=3.5 jitter=12 scale=0.6-1.4 seed=89
# shade trees between the giant trunks (none behind the grandstand), forest tree lines out to the horizon
PROPS kind=tree_round_big from=@pond_s to=@log_tunnel-6 side=R every=16 offset=13 jitter=16 scale=0.8-1.3 seed=90
PROPS kind=tree_round_big from=@pond_s to=@home side=L every=16 offset=13 jitter=16 scale=0.8-1.3 seed=91
PROPS kind=tree_round_big from=@trail+70 to=@log_tunnel-6 side=L every=16 offset=13 jitter=16 scale=0.8-1.3 seed=92
PROPS kind=tree_round_big from=@fern_s+6 to=@log_bridge-4 side=both every=16 offset=13 jitter=16 scale=0.8-1.3 seed=93
PROPS kind=tree_clump side=both every=26 offset=60 jitter=50 scale=0.9-1.4 seed=94
PROPS kind=tree_clump side=both every=34 offset=125 jitter=50 scale=1.0-1.6 seed=95
# the mossy bypass gets its own undergrowth
PROPS kind=grass_tuft along=mossy_bypass side=both every=1.2 offset=0.2 jitter=5 scale=0.9-1.5 seed=96
PROPS kind=mushroom_patch along=mossy_bypass side=both every=12 offset=0.5 jitter=4 seed=97
PROP kind=hot_air_balloon at=(60.0,58.0,-160.0) yaw=20 scale=1.1
PROP kind=hot_air_balloon at=(-170.0,52.0,-260.0) yaw=0 scale=0.9
THEME canopy_forest sky=day time=08:00 scatter=forest_wall,forest_wall,tree_round_big,tree_round_big,tree_clump,bush_round,rock_cluster,rock_moss,stump,mossy_log,mushroom_red density=30 hills=4 fogNear=140 fogFar=950
