# Rainline Boulevard — Neon Harbor D3 (both modes). A rainy night run down a six-lane boulevard, through the neon
# arcade S and the container yard, up onto an overpass that crosses 9 m above the boulevard, spiralling 270° back
# down under its own deck into the noodle-bar market and home along the canal and the plaza.
@signature hazard:traffic, surfaces, branch, stacked
TRACK rainline_blvd name="Rainline Boulevard" theme=neon_harbor diff=3 laps=3 topo=circuit
DEFAULTS w=14 surf=wet wall=barrier:1.1 shoulder=0 shoulderSurf=asphalt blend=20
START pos=(0,0,0) hdg=0
GRID rows=4 cols=2 pitch=7 stagger=3.5 d=3.5
S ?a w=16                                   @boulevard
C R20 90 L w=14 bank=5                      @arcade_corner
WIGGLE R28 35/70/35 R w=15                     @arcade_s
S 35                                        @alley_split
C R30 90 L bank=5                           @crane_corner
S ?b                                        @container_row
WIGGLE R70 30/60/30 L                       @tram_s
C R16 150 L bank=6 dy=2                     @crane_hairpin
S 55 dy=5.5 wall=parapet:1.1                @overpass_ramp
C R40 31 R bank=-4 dy=1.5                   @overpass_bend
WIGGLE R140 12/24/12 R                      @elevated_deck
S ?c                                        @boulevard_bridge
C R30 270 L dy=-9 bank=6                    @spiral_exit
WIGGLE R30 40/80/40 R surf=wet wall=barrier:1.1 @sodium_s
S 44 wall=building:1.4 surf=cobble          @market_street
S 40                                        @sodium_straight
C R20 120 R bank=-6                         @noodle_corner
C R90 80 R                           @canal
C R40 9 R bank=-4                   @plaza_kink
S 53 w=16                                   @to_line
CLOSE solve=[?a,?b,?c] length=1350
LINE start at=@boulevard+40
PAD at=@boulevard+20,@to_line+2 d=0 len=6 w=4
ITEMS at=@tram_s+53,@elevated_deck+43,@market_street+22,@canal+55,@boulevard+35 n=5
# evening traffic in the two left lanes of the boulevard (the right half always clear), after the grid
HAZ traffic cars at=@boulevard+62 to=@boulevard+128 lanes=[(d -5, speed 16, count 2, spacing 33),(d -2, speed 12, count 1, spacing 66)]
# the neon alley: a 7 m shortcut cutting inside the harbour-crane corner
BRANCH alley from=@alley_split+4 to=@container_row+48 kind=shortcut aiMin=0.5 w=8 wall=building:3.5 surf=cobble {
  C R20 45 L wallR=building:3.5:soft ; S ?x wallR=building:3.5:soft ; C R20 45 L ; S ?y
}
# ---- dressing (Neon Harbor kit, stylized pass 2026-10, render-only: the .ctrk is unchanged) ----
# A rainy night street: shop-front blocks line both sides (fronts 7–9 m behind the barrier, alleys between them),
# slim towers behind, the skyline beyond; lamps, planters, street trees and benches on the sidewalks; harbour cranes,
# containers and a warehouse at the yard; shophouses, noodle stalls and lantern strings in the market.
# The a3 start-wide camera stands 8 m beyond the right edge before the grid and the b2 camera 30 m outside T1, so
# those patches keep low furniture only.
# The towers are placed as PROPs by a clearance pass (end of file): every footprint keeps ≥ 26 m from all road
# surfaces at any height, so no tower stands under or beside the overpass and the street blocks stay in front.
THEME scatter=none hills=0 sky=night fogNear=90 fogFar=720
# -- start straight (to_line + boulevard): grandstand opposite the grid, banner poles, spectators, neon boards
# (the stand sits past the line's ±10 m keep-out, opposite the grid's front rows)
PROPS kind=grandstand from=@boulevard+62 to=@boulevard+63 side=L every=100 offset=5.5 seed=101
PROPS kind=flag_pole from=@boulevard+6 to=@boulevard+110 side=L every=9 offset=2.2 seed=102
PROPS kind=spectators from=@boulevard+80 to=@boulevard+114 side=L every=14 offset=2.6 jitter=1 seed=103
PROPS kind=spectators from=@to_line+8 to=@to_line+50 side=R every=16 offset=2.4 jitter=1 seed=104
PROPS kind=ad_board_a from=@boulevard+30 to=@boulevard+116 side=R every=24 offset=0.4 seed=105
PROPS kind=ad_board_b from=@boulevard+38 to=@boulevard+116 side=R every=24 offset=0.4 seed=106
PROPS kind=ad_board_c from=@boulevard+46 to=@boulevard+116 side=R every=24 offset=0.4 seed=107
PROPS kind=ad_board_c from=@to_line+4 to=@to_line+52 side=both every=16 offset=0.4 seed=108
# -- T1 (arcade corner, left): tyre wall and chevron boards on the outside, an open plaza behind them
PROPS kind=tyre_wall from=@arcade_corner-2 to=@arcade_corner+32 side=R every=1.3 offset=0.6 seed=110
PROPS kind=ad_board_b from=@arcade_corner+1 to=@arcade_corner+30 side=R every=8 offset=2.6 seed=111
PROPS kind=street_lamp from=@arcade_corner+4 to=@arcade_corner+30 side=R every=13 offset=5 seed=112
PROPS kind=bus_shelter from=@arcade_corner+38 to=@arcade_corner+39 side=R every=50 offset=2.2 seed=113
# -- street blocks, both sides, the whole lap (four facade kinds in 24 m slots; setback jitter breaks the wall)
PROPS kind=building_row_a from=@boulevard+52 to=@arcade_corner side=L every=96 offset=8 jitter=1.5 seed=120
PROPS kind=building_row_b from=@boulevard+76 to=@arcade_corner side=L every=96 offset=8 jitter=1.5 seed=121
PROPS kind=building_row_d from=@boulevard+30 to=@boulevard+31 side=L every=96 offset=16 seed=122
# (the right side of the start straight is only 8 m from the spiral exit, and the overpass crosses the run-in:
# one block by T1, no blocks on the run-in)
PROPS kind=building_row_c from=@boulevard+97 to=@boulevard+98 side=R every=72 offset=8 seed=123
PROPS kind=building_row_a from=@arcade_s to=@crane_corner side=both every=96 offset=8 jitter=2 seed=126
PROPS kind=building_row_b from=@arcade_s+24 to=@crane_corner side=both every=96 offset=8 jitter=2 seed=127
PROPS kind=building_row_c from=@arcade_s+48 to=@crane_corner side=both every=96 offset=8 jitter=2 seed=128
PROPS kind=building_row_d from=@arcade_s+72 to=@crane_corner side=both every=96 offset=8 jitter=2 seed=129
PROPS kind=building_row_a from=@tram_s to=@crane_hairpin-40 side=both every=96 offset=8 jitter=2 seed=130
PROPS kind=building_row_d from=@tram_s+24 to=@crane_hairpin-40 side=both every=96 offset=8 jitter=2 seed=131
PROPS kind=building_row_b from=@tram_s+48 to=@crane_hairpin-40 side=both every=96 offset=8 jitter=2 seed=132
PROPS kind=building_row_c from=@tram_s+72 to=@crane_hairpin-40 side=both every=96 offset=8 jitter=2 seed=133
# beside the overpass the blocks stand on the ground below the deck (trackc: offset > 2 → ground), 9 m out
# (the deck crosses the run-in and the sodium S between elevated_deck+50 and the spiral: no blocks there)
PROPS kind=building_row_d from=@overpass_ramp+20 to=@elevated_deck+48 side=both every=96 offset=9 jitter=2 seed=134
PROPS kind=building_row_b from=@overpass_ramp+44 to=@elevated_deck+48 side=both every=96 offset=9 jitter=2 seed=135
PROPS kind=building_row_a from=@overpass_ramp+68 to=@elevated_deck+48 side=both every=96 offset=9 jitter=2 seed=136
PROPS kind=building_row_c from=@overpass_ramp+92 to=@elevated_deck+48 side=both every=96 offset=9 jitter=2 seed=137
PROPS kind=building_row_b from=@spiral_exit+20 to=@spiral_exit+110 side=R every=26 offset=10 jitter=2 seed=142
# (sodium S: the right side backs onto the start straight and the bridge descends over the left: shophouses only)
PROPS kind=building_row_d from=@canal+10 to=@plaza_kink side=L every=48 offset=9 jitter=2 seed=140
PROPS kind=building_row_c from=@canal+34 to=@plaza_kink side=L every=48 offset=9 jitter=2 seed=141
# -- sidewalk life: lamps (on the deck edge over the overpass), planters, street trees, benches, vending machines
PROPS kind=street_lamp along=main side=both every=30 offset=0.6 seed=160
PROPS kind=traffic_signal from=@boulevard+70 to=@boulevard+71 side=R every=100 offset=0.8 seed=173
PROPS kind=traffic_signal from=@tram_s+30 to=@tram_s+120 side=both every=90 offset=0.8 seed=174
PROPS kind=traffic_signal from=@sodium_straight+6 to=@sodium_straight+7 side=R every=100 offset=0.8 seed=175
PROPS kind=planter_bush from=@boulevard+118 to=@crane_corner side=both every=9 offset=2.4 jitter=0.6 seed=161
PROPS kind=planter_bush from=@boulevard+28 to=@boulevard+118 side=R every=12 offset=2.4 jitter=0.4 seed=176
PROPS kind=street_tree from=@boulevard+34 to=@boulevard+118 side=R every=16 offset=4.6 jitter=0.6 scale=0.9-1.2 seed=177
PROPS kind=planter_bush from=@tram_s to=@crane_hairpin side=both every=9 offset=2.4 jitter=0.6 seed=162
PROPS kind=planter_bush from=@sodium_s to=@to_line+50 side=both every=10 offset=2.4 jitter=0.6 seed=163
PROPS kind=street_tree from=@arcade_s to=@crane_corner side=both every=16 offset=4.4 jitter=1 scale=0.9-1.2 seed=164
PROPS kind=street_tree from=@tram_s to=@crane_hairpin side=both every=16 offset=4.4 jitter=1 scale=0.9-1.2 seed=165
PROPS kind=street_tree from=@overpass_ramp+20 to=@elevated_deck+48 side=both every=18 offset=4.6 jitter=1 scale=0.9-1.3 seed=166
PROPS kind=street_tree from=@canal to=@plaza_kink side=both every=14 offset=4.4 jitter=1 scale=0.9-1.3 seed=167
PROPS kind=street_bench from=@arcade_s to=@crane_corner side=both every=37 offset=2.6 seed=168
PROPS kind=street_bench from=@canal to=@plaza_kink side=both every=29 offset=2.6 seed=169
PROPS kind=vending_machine from=@arcade_s+10 to=@crane_corner side=both every=53 offset=3.2 seed=170
PROPS kind=vending_machine from=@tram_s+20 to=@crane_hairpin side=both every=61 offset=3.2 seed=171
PROPS kind=bus_shelter from=@tram_s+30 to=@crane_hairpin side=L every=70 offset=2.4 seed=172
# -- neon arcade S and the market: blade signs and billboards (kept clear of the road: ≥ 2.5 m out)
PROPS kind=neon_sign from=@arcade_s to=@alley_split side=both every=21 offset=3 seed=180
PROPS kind=neon_sign from=@market_street to=@sodium_straight+40 side=both every=24 offset=3 seed=181
PROPS kind=neon_sign from=@tram_s+10 to=@crane_hairpin side=both every=44 offset=3 seed=182
PROPS kind=billboard from=@to_line+10 to=@to_line+11 side=R every=50 offset=5 seed=183
PROPS kind=billboard from=@canal+10 to=@canal+110 side=R every=55 offset=5 seed=184
PROPS kind=billboard from=@sodium_s+10 to=@sodium_s+70 side=L every=50 offset=5 seed=185
# -- harbour: containers and crates on the yard side, cranes, a warehouse, the tram stop
PROPS kind=container_stack from=@crane_corner+10 to=@container_row+90 side=R every=17 offset=4 seed=190
PROPS kind=container_stack from=@crane_corner+18 to=@container_row+90 side=R every=17 offset=12 jitter=2 seed=191
PROPS kind=container_stack from=@container_row to=@container_row+80 side=L every=21 offset=14 jitter=2 seed=192
PROPS kind=cargo_crate from=@crane_corner to=@tram_s side=both every=13 offset=2.4 jitter=1 seed=193
PROPS kind=harbor_crane from=@crane_corner to=@crane_corner+60 side=L every=60 offset=20 seed=194
PROPS kind=harbor_crane from=@container_row+40 to=@container_row+41 side=R every=60 offset=26 seed=195
PROPS kind=warehouse_building from=@container_row+20 to=@container_row+21 side=L every=60 offset=4 seed=196
PROPS kind=station_canopy from=@tram_s+12 to=@tram_s+12 side=R every=100 offset=2.5
# -- market street and the noodle corner: shophouses, stalls, lanterns across the street
PROPS kind=shophouse from=@sodium_s+75 to=@noodle_corner side=both every=15 offset=6 jitter=1 seed=200
PROPS kind=noodle_stall from=@market_street to=@noodle_corner+30 side=both every=19 offset=2.4 seed=201
PROPS kind=vending_machine from=@market_street+8 to=@noodle_corner side=both every=27 offset=3.4 seed=202
PROP kind=lantern_string at=(-76.5,-0.4,89.6) yaw=119 scale=1
PROP kind=lantern_string at=(-86.1,-0.4,94.9) yaw=119 scale=1
PROP kind=lantern_string at=(-95.7,-0.4,100.2) yaw=119 scale=1
# -- landmark: a neon tower in the eye of the spiral exit
PROP kind=tower_b at=(50.3,-0.4,53.5) yaw=20 scale=1.35
# -- skyline (generated: slim towers 26–64 m and 74–175 m from every road at any height and clear of the street blocks, yaw along the nearest street, y = baked terrain − 0.3 m; keep-outs around the a3 and b2 cameras)
