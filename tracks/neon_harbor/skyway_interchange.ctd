# Skyway Interchange — Neon Harbor D4 (speed). Dusk over the harbour city: from the toll plaza a three-level cloverleaf
# climbs to the 20 m skyway, which flies back over the toll plaza; a rooftop jump drops toward the billboards, the
# subway descent reaches the platform where a metro train crosses, and the service road and strobe tunnel bring you home.
@signature cloverleaf, stacked, hazard:train, jump
TRACK skyway_interchange name="Skyway Interchange" theme=neon_harbor diff=4 laps=2 topo=circuit
DEFAULTS w=13 surf=asphalt wall=barrier:1.1 shoulder=0 blend=18
START pos=(0,0,0) hdg=0
GRID rows=4 cols=2 pitch=6.5 stagger=3.2 d=3.2
S ?a w=14                                   @toll_plaza
CLOVERLEAF levels=0/10/20 R=35 side=L link=41/33 Rc=20   @cloverleaf
S ?b                                        @skyway
WIGGLE R100 12/24/12 L                      @skyway_s
C R30 90 L bank=5                           @billboard_corner
WIGGLE R60 30/60/30 R                       @billboard_s
S 30                                        @rooftop_run
J ramp=10@6 gap=16 drop=6 land=40 vmin=26 vmax=46 w=14 @rooftop_jump
HELIX R35 360 R dy=-12 bank=-8              @ramp_c
WIGGLE R80 25/50/25 L dy=-2                 @subway_descent
C R40 60 L bank=4                           @ramp_sweep
S ?c                                        @subway_approach
C R40 60 R bank=-4                          @subway_corner
S 50                                        @subway_platform
C R14 180 L bank=6                          @tunnel_hairpin
S 40                                        @strobe_tunnel
WIGGLE R30 40/80/40 L                       @service_s
WIGGLE R70 35/70/35 R                       @frontage_s
WIGGLE R80 30/60/30 L                       @frontage_s2
CLOSE solve=[?a,?b,?c] length=2000
LINE start at=@toll_plaza+30
PAD at=@toll_plaza+50 d=-3.5 len=6 w=4
PAD at=@toll_plaza+50 d=3.5 len=6 w=4
ITEMS at=@toll_plaza+110,@cloverleaf+184,@skyway+41,@billboard_s+65,@subway_descent+53,@strobe_tunnel+21,@frontage_s+89,@frontage_s2+78 n=5
# the metro crosses the subway platform every 10 s: lights and horn 1.5 s ahead, the crossing is closed for 2.5 s
HAZ train metro at=@subway_platform+25 d=0 box=(24,3.4,4) period=10 on=0-2.5 tele=1.5 offset=0 span=25
# ---- dressing (Neon Harbor kit, stylized pass 2026-10, render-only: the .ctrk is unchanged) ----
# Dusk over the harbour city. Street blocks with shop fronts line the ground-level roads (frontage, service, subway),
# the elevated rooftop run flies over a row of lower blocks, and a clearance pass places the skyline towers (end of
# file) ≥ 26 m from every deck at any height, so nothing stands under the cloverleaf or the skyway. Deck-edge rows
# (offset ≤ 2: lamps, boards) stand on the deck; everything farther out stands on the ground below.
# The a3 start-wide camera stands 9 m beyond the right edge before the line and the b2 camera 30 m outside the
# cloverleaf entry, so those patches keep low furniture only.
THEME scatter=none hills=0 sky=sunset fogNear=160 fogFar=1100
# -- toll plaza (start straight): toll booths, grandstand opposite the a3 camera, banner poles, neon boards
PROPS kind=toll_booth from=@toll_plaza+68 to=@toll_plaza+68 side=both every=100 offset=1.5
PROPS kind=grandstand from=@toll_plaza+38 to=@toll_plaza+39 side=L every=100 offset=5.5 seed=201
PROPS kind=flag_pole from=@toll_plaza+4 to=@toll_plaza+60 side=L every=9 offset=2.2 seed=202
PROPS kind=spectators from=@toll_plaza+52 to=@toll_plaza+62 side=L every=10 offset=2.6 jitter=1 seed=203
PROPS kind=spectators from=@frontage_s2+130 to=@frontage_s2+165 side=R every=16 offset=2.4 jitter=1 seed=204
PROPS kind=ad_board_a from=@toll_plaza+22 to=@toll_plaza+60 side=R every=24 offset=0.4 seed=205
PROPS kind=ad_board_b from=@toll_plaza+30 to=@toll_plaza+60 side=R every=24 offset=0.4 seed=206
PROPS kind=ad_board_c from=@toll_plaza+38 to=@toll_plaza+60 side=R every=24 offset=0.4 seed=207
PROPS kind=ad_board_c from=@frontage_s2+120 to=@frontage_s2+165 side=both every=16 offset=0.4 seed=208
PROPS kind=street_lamp from=@toll_plaza to=@toll_plaza+140 side=both every=35 offset=0.6
PROPS kind=bus_shelter from=@toll_plaza+90 to=@toll_plaza+91 side=L every=50 offset=2.4 seed=209
# -- T1 (cloverleaf entry, a long climbing left): tyre wall and chevron boards on the outside
PROPS kind=tyre_wall from=@cloverleaf-4 to=@cloverleaf+44 side=R every=1.3 offset=0.6 seed=210
PROPS kind=ad_board_b from=@cloverleaf+2 to=@cloverleaf+42 side=R every=9 offset=2.6 seed=211
# -- street blocks on the ground-level roads (four facade kinds in 24 m slots, setback jitter)
PROPS kind=building_row_d from=@frontage_s2+120 to=@frontage_s2+160 side=L every=96 offset=8 jitter=1.5 seed=220
PROPS kind=building_row_a from=@toll_plaza+10 to=@toll_plaza+55 side=L every=96 offset=16 seed=221
PROPS kind=building_row_a from=@frontage_s to=@frontage_s2+110 side=L every=96 offset=8 jitter=2 seed=222
PROPS kind=building_row_b from=@frontage_s+24 to=@frontage_s2+110 side=L every=96 offset=8 jitter=2 seed=223
PROPS kind=building_row_c from=@frontage_s+48 to=@frontage_s2+110 side=L every=96 offset=8 jitter=2 seed=224
PROPS kind=building_row_d from=@frontage_s+72 to=@frontage_s2+110 side=L every=96 offset=8 jitter=2 seed=225
PROPS kind=building_row_c from=@frontage_s to=@frontage_s+170 side=R every=48 offset=8 jitter=2 seed=226
PROPS kind=building_row_a from=@frontage_s+24 to=@frontage_s+170 side=R every=48 offset=8 jitter=2 seed=227
# (the service road's left side backs onto the subway platform 14 m away: blocks on the right only)
PROPS kind=building_row_b from=@service_s to=@frontage_s side=R every=48 offset=8 jitter=2 seed=228
PROPS kind=building_row_d from=@service_s+24 to=@frontage_s side=R every=48 offset=8 jitter=2 seed=229
# (the helix stands over the first 50 m of the descent on the right; the platform's left side faces the service road)
PROPS kind=building_row_a from=@subway_descent+20 to=@ramp_sweep side=L every=72 offset=8 jitter=2 seed=230
PROPS kind=building_row_c from=@subway_descent+44 to=@ramp_sweep side=L every=72 offset=8 jitter=2 seed=231
PROPS kind=building_row_b from=@subway_descent+68 to=@ramp_sweep side=L every=72 offset=8 jitter=2 seed=232
PROPS kind=building_row_d from=@subway_descent+60 to=@ramp_sweep side=R every=48 offset=8 jitter=2 seed=237
PROPS kind=building_row_b from=@subway_descent+84 to=@ramp_sweep side=R every=48 offset=8 jitter=2 seed=238
PROPS kind=building_row_d from=@subway_approach to=@subway_platform side=R every=48 offset=8 jitter=2 seed=233
PROPS kind=building_row_c from=@subway_approach+24 to=@subway_platform side=R every=48 offset=8 jitter=2 seed=234
# the rooftop run: lower blocks beside and below the 20 m deck (their roofs pass just under the drivers' eye line)
PROPS kind=building_row_c from=@billboard_s to=@rooftop_jump side=both every=48 offset=9 jitter=2 seed=235
PROPS kind=building_row_a from=@billboard_s+24 to=@rooftop_jump side=both every=48 offset=9 jitter=2 seed=236
# -- sidewalk life on the ground-level roads: planters, street trees, benches, vending machines, bus shelters
PROPS kind=planter_bush from=@subway_descent+60 to=@subway_approach side=both every=10 offset=2.4 jitter=0.6 seed=240
PROPS kind=planter_bush from=@service_s to=@toll_plaza+20 side=both every=10 offset=2.4 jitter=0.6 seed=241
PROPS kind=street_tree from=@service_s to=@frontage_s2+110 side=both every=16 offset=4.4 jitter=1 scale=0.9-1.3 seed=242
PROPS kind=street_tree from=@subway_descent+60 to=@subway_approach side=both every=16 offset=4.4 jitter=1 scale=0.9-1.3 seed=243
PROPS kind=street_bench from=@frontage_s to=@frontage_s2+110 side=both every=37 offset=2.6 seed=244
PROPS kind=vending_machine from=@frontage_s+10 to=@frontage_s2+110 side=both every=57 offset=3.2 seed=245
PROPS kind=bus_shelter from=@frontage_s+40 to=@frontage_s2+100 side=L every=90 offset=2.4 seed=246
PROPS kind=street_lamp from=@service_s to=@frontage_s2+160 side=both every=32 offset=0.6 seed=247
PROPS kind=street_lamp from=@cloverleaf to=@service_s side=both every=36 offset=0.6 seed=248
# -- billboards, blade signs, the subway station, tunnel strobes
PROPS kind=billboard from=@subway_descent to=@subway_approach side=R every=45 offset=5
PROPS kind=billboard from=@billboard_corner to=@billboard_s+40 side=R every=40 offset=5 seed=250
PROPS kind=neon_sign from=@frontage_s to=@frontage_s2+150 side=both every=45 offset=3
PROPS kind=neon_sign from=@subway_descent+60 to=@subway_platform side=R every=40 offset=3 seed=251
PROPS kind=station_canopy from=@subway_platform+6 to=@subway_platform+6 side=L every=100 offset=2
PROPS kind=strobe_bar from=@strobe_tunnel to=@strobe_tunnel+40 side=both every=8 offset=0.3
# -- harbour along the frontage: containers, crates, a crane and a warehouse
PROPS kind=container_stack from=@frontage_s2 to=@frontage_s2+110 side=R every=30 offset=6
PROPS kind=container_stack from=@frontage_s2+15 to=@frontage_s2+110 side=R every=30 offset=14 jitter=2 seed=260
PROPS kind=cargo_crate from=@frontage_s2 to=@frontage_s2+110 side=R every=13 offset=2.4 jitter=1 seed=261
PROPS kind=harbor_crane from=@frontage_s+20 to=@frontage_s+170 side=R every=150 offset=26
PROPS kind=warehouse_building from=@frontage_s2+60 to=@frontage_s2+61 side=R every=60 offset=24 seed=262
