# Skyway Interchange — Neon Harbor D4 (speed). Dusk over the harbour city: from the toll plaza a three-level cloverleaf
# climbs to the 18 m skyway, a rooftop jump drops you back toward the billboards, ramp C spirals down to the subway,
# a train crosses the platform approach, and the strobe tunnel and the frontage sweepers bring you home.
@signature cloverleaf, stacked, hazard:train, jump
TRACK skyway_interchange name="Skyway Interchange" theme=neon_harbor diff=4 laps=2 topo=circuit
DEFAULTS w=13 surf=asphalt wall=barrier:1.1 shoulder=0 blend=18
START pos=(0,0,0) hdg=0
GRID rows=4 cols=2 pitch=6.5 stagger=3.2 d=3.2
S ?a w=14                                   @toll_plaza
C R25 90 L w=13 bank=5                      @toll_corner
S 14                                        @ramp_in
CLOVERLEAF levels=0/10/20 R=35 side=L link=41/33 Rc=20   @cloverleaf
S 14                                        @skyway
C R16 150 R bank=-6                         @skyway_hairpin
S 54                                        @rooftop_run
J ramp=10@6 gap=16 drop=2 land=45 vmin=24 vmax=46 w=14 @rooftop_jump
C R30 130 R w=13 bank=-5             @billboard_corner
C R35 270 R dy=-18 bank=-8                  @ramp_c
S ?b                                        @subway_approach
C R20 90 L bank=5                           @subway_corner
S 24                                        @strobe_tunnel
C R14 180 L bank=6                          @tunnel_hairpin
WIGGLE R20 45/90/45 R                       @service_s
S ?c                                        @service_road
C R40 103 R bank=-4                   @toll_return
C R100 5 L                          @toll_kink
WIGGLE R70 35/70/35 R dy=18                 @frontage_s
WIGGLE R80 30/60/30 L dy=-18                @frontage_s2
C R100 87 L                          @onramp_in
C R100 9 R                          @onramp_out
C R30 120 L bank=6                          @tollgate_hairpin
S 56                                        @to_line
CLOSE solve=[?a,?b,?c] length=2025
LINE start at=@toll_plaza+10
THEME scatter=tower_a,tower_b density=6 hills=0 sky=sunset
