# Skyway Interchange — Neon Harbor D4 (speed). Dusk over the harbour city: from the toll plaza a three-level cloverleaf
# climbs to the 20 m skyway, which flies back over the toll plaza; a rooftop jump drops toward the billboards, the
# subway descent reaches the platform where a metro train crosses, and the service road and strobe tunnel bring you home.
@signature cloverleaf, stacked, hazard:train, jump
TRACK skyway_interchange name="Skyway Interchange" theme=neon_harbor diff=4 laps=2 topo=circuit
DEFAULTS w=13 surf=asphalt wall=barrier:1.1 shoulder=0 blend=18
START pos=(0,0,0) hdg=0
GRID rows=4 cols=2 pitch=6.5 stagger=3.2 d=3.2
S ?a w=14                                   @toll_plaza
CLOVERLEAF levels=0/10/20 R=35 side=L link=41/33 Rc=20   @cloverleaf
S ?b                                        @skyway
WIGGLE R100 12/24/12 L                      @skyway_s
C R30 90 L bank=5                           @billboard_corner
WIGGLE R60 30/60/30 R                       @billboard_s
S 30                                        @rooftop_run
J ramp=10@6 gap=16 drop=6 land=40 vmin=26 vmax=46 w=14 @rooftop_jump
HELIX R35 360 R dy=-12 bank=-8              @ramp_c
WIGGLE R80 25/50/25 L dy=-2                 @subway_descent
C R40 60 L bank=4                           @ramp_sweep
S ?c                                        @subway_approach
C R40 60 R bank=-4                          @subway_corner
S 50                                        @subway_platform
C R14 180 L bank=6                          @tunnel_hairpin
S 40                                        @strobe_tunnel
WIGGLE R30 40/80/40 L                       @service_s
WIGGLE R70 35/70/35 R                       @frontage_s
WIGGLE R80 30/60/30 L                       @frontage_s2
CLOSE solve=[?a,?b,?c] length=2000
LINE start at=@toll_plaza+30
PAD at=@toll_plaza+50 d=-3.5 len=6 w=4
PAD at=@toll_plaza+50 d=3.5 len=6 w=4
ITEMS at=@toll_plaza+110,@cloverleaf+184,@skyway+41,@billboard_s+65,@subway_descent+53,@strobe_tunnel+21,@frontage_s+89,@frontage_s2+78 n=5
# the metro crosses the subway platform every 10 s: lights and horn 1.5 s ahead, the crossing is closed for 2.5 s
HAZ train metro at=@subway_platform+25 d=0 box=(24,3.4,4) period=10 on=0-2.5 tele=1.5 offset=0 span=25
THEME scatter=tower_a,tower_b density=6 hills=0 sky=sunset
