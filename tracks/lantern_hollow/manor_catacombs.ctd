# Manor Catacombs — Lantern Hollow D4 (both modes). Night at the hill-top manor: the garden straight, the fountain,
# the manor gate, a toy-scale ballroom crossed along the giant table, the chandelier bend, the 12 m corridor, a
# spiral staircase down 270° into the catacombs (its exit passes under its own entry), a crypt grid of R12 corners,
# the ossuary, the bat cave, the portal back up to the garden terrace (which crosses over the catacombs), hedges,
# roses, the hedge maze, the orangery and the gazebo hairpin.
@signature warp, hazard:press, hazard:swinger, stacked
TRACK manor_catacombs name="Manor Catacombs" theme=lantern_hollow diff=4 laps=2 topo=circuit
DEFAULTS w=13 surf=cobble wall=parapet:1.2 shoulders=0:stone blend=15
START pos=(0,0,0) hdg=0
GRID rows=4 cols=2 pitch=7 stagger=3.5 d=3.2
S ?a                                              @garden_straight
C R30 80 L bank=5                                 @fountain_corner
S ?c                                              @manor_gate
C R40 68 R bank=-4                                @ballroom_entry
S 52 surf=wood w=14                               @ballroom_table
C R20 102 L bank=6 surf=stone w=14                @chandelier_bend
S 26 w=12                                         @corridor
WIGGLE R18 50/100/30 R bank=4 w=15 wall=parapet:1.2:soft   @corridor_s
C R20 270 L dy=-10 bank=6 w=14 wall=parapet:1.2:soft   @spiral_stair
S 38 w=14 wall=parapet:1.2                        @catacomb_entry
C R12 81 L bank=4 w=16                            @crypt_1
S 22 w=15                                         @crypt_a
C R12 66 L bank=4 w=16                            @crypt_2
S 16 w=15                                         @crypt_b
C R12 101 R bank=4 w=16                           @crypt_3
S 23 w=15                                         @crypt_c
C R14 134 L bank=6 w=16                           @ossuary_hairpin
WIGGLE R18 38/97/36 L bank=4 w=16 wall=parapet:1.2:soft                 @ossuary_s
S 32 w=13 wall=parapet:1.2                        @bat_cave
C R25 110 R bank=5                                @bat_cave_exit
S 125 dy=10 warp=portal                           @portal_warp
S 28 surf=cobble                                  @garden_terrace
C R35 107 R bank=5                                @hedge_corner
C R60 77 R bank=-4                                @rose_corner
WIGGLE R70 17/51/48 L bank=3                      @rose_s
WIGGLE R25 27/70/33 R bank=5 w=16 wall=parapet:1.2:soft                 @hedge_maze_s
S 24 w=13 wall=parapet:1.2                        @hedge_maze_straight
C R80 54 R bank=-4                                @orangery_sweeper
WIGGLE R60 19/36/26 R bank=3                      @orangery_s
C R70 48 R bank=-4                                @greenhouse_corner
S ?b                                              @greenhouse_walk
C R30 68 R bank=-4                                @gazebo_kink
C R30 176 L bank=6 w=16                           @gazebo_hairpin
C R40 72 L bank=4 w=13                            @gazebo_exit
S 40                                              @home
CLOSE solve=[?a,?b,?c] length=1800
LINE start at=0

# the bat-cave portal: a 48-tick warp back up to the garden terrace (the 125 m span has no ground)
WARP portal transit=0.8 keep

# chandeliers swing over the giant table and the chandelier bend; the bookcase press slams down on the right half of
# the last crypt straight (half the road always stays open)
HAZ swinger chandelier1 at=@ballroom_table+30 d=0 capsule=(1.2,1.0) arm=8 amp=40 plane=across period=3 offset=0 prop=hazard_chandelier
HAZ swinger chandelier2 at=@chandelier_bend+18 d=0 capsule=(1.2,1.0) arm=8 amp=30 plane=along period=3 offset=1.5 prop=hazard_chandelier
HAZ press bookcase at=@crypt_c+11 d=+4 box=(4,6,3) period=4 on=0-2 tele=0.8 rise=4 effect=block prop=hazard_bookcase

# 6 rows ≈ L/250 (−1): garden straight, catacomb entry, bat cave, garden terrace, orangery, greenhouse walk
ITEMS at=@garden_straight+70,@catacomb_entry+19,@bat_cave+16,@garden_terrace+14,@orangery_sweeper+32,@greenhouse_walk+12 n=5
# a pair of pads side by side where the gazebo exit opens onto the home straight
PAD at=@home+3 d=-3 len=6 w=4
PAD at=@home+3 d=3 len=6 w=4
KEYS @garden_straight+50,@ballroom_table+18,@corridor+13,@catacomb_entry+10,@ossuary_s+30,@garden_terrace+20,@rose_s+60,@orangery_s+40,@gazebo_exit+20

# --- dressing: lantern-lit hedge gardens above, candle-lit crypt vaults below
PROPS kind=hedge from=@garden_straight to=@fountain_corner side=both every=8 offset=0.4
PROPS kind=lantern_post from=@garden_straight+5 to=@fountain_corner side=both every=24 offset=2
PROPS kind=hedge from=@home to=@home+40 side=both every=8 offset=0.4
PROPS kind=rose_bush from=@fountain_corner to=@manor_gate side=L every=16 offset=3
PROPS kind=iron_fence from=@manor_gate to=@ballroom_entry side=both every=8 offset=0.4
PROPS kind=jack_o_lantern from=@manor_gate to=@ballroom_entry side=both every=12 offset=1.2
PROPS kind=candelabra from=@ballroom_entry to=@corridor side=both every=14 offset=1.5
PROPS kind=portrait from=@ballroom_entry+10 to=@corridor side=both every=18 offset=3
PROPS kind=giant_cutlery from=@ballroom_table+8 to=@ballroom_table+44 side=both every=18 offset=2
PROPS kind=candelabra from=@corridor to=@spiral_stair side=both every=10 offset=1
PROPS kind=portrait from=@corridor to=@spiral_stair side=both every=12 offset=2
PROPS kind=candles from=@spiral_stair to=@catacomb_entry side=R every=14 offset=1
PROPS kind=coffin from=@catacomb_entry to=@ossuary_hairpin side=both every=11 offset=1
PROPS kind=candles from=@crypt_1 to=@bat_cave side=both every=9 offset=0.8
PROPS kind=gravestone from=@ossuary_hairpin to=@bat_cave side=both every=12 offset=1.5
PROPS kind=bat from=@bat_cave to=@bat_cave_exit side=both every=10 offset=2
PROPS kind=bookcase from=@crypt_b to=@crypt_c+23 side=L every=9 offset=0.5
PROPS kind=hedge from=@garden_terrace to=@orangery_sweeper side=both every=8 offset=0.4
PROPS kind=rose_bush from=@rose_corner to=@hedge_maze_s side=both every=14 offset=3
PROPS kind=lantern_post from=@hedge_corner to=@orangery_sweeper side=both every=30 offset=2
PROPS kind=crooked_tree from=@orangery_sweeper to=@greenhouse_walk side=both every=20 offset=5 jitter=4
PROPS kind=lantern_string from=@orangery_sweeper to=@greenhouse_walk side=both every=14 offset=1.5
PROPS kind=hedge from=@greenhouse_walk to=@home side=both every=8 offset=0.4
PROPS kind=jack_o_lantern from=@gazebo_kink to=@home side=both every=11 offset=1
PROP kind=crypt_vault at=(224.4,-10.2,-233.7) yaw=-145.0
PROP kind=crypt_vault at=(176.0,-10.2,-260.3) yaw=180.0
PROP kind=crypt_vault at=(176.0,-10.2,-275.3) yaw=180.0
PROP kind=giant_table at=(192.3,-0.2,-109.0) yaw=102.0
PROP kind=chandelier at=(187.9,-11.0,-197.4) yaw=0 scale=1.4
PROP kind=fountain at=(98.1,-0.3,-29.9) yaw=0 scale=1.2
PROP kind=gazebo at=(-49.6,-0.3,-37.1) yaw=0
PROP kind=manor at=(45.0,-0.3,60.0) yaw=-90
# ---- stylized dressing pass (2026-10, docs/design/34-stylized-pass.md; render-only, the .ctrk is unchanged) ----
# Outdoors the road runs between clipped hedges, so the garden layers stand behind them (topiary, roses, autumn trees,
# the far woods) and read over the hedge tops; the vaults below keep their candle-lit dressing.
# the garden straight: a festival grandstand over the hedge, topiary and lanterns; the straw-bale wall at T1
PROPS kind=grandstand from=@garden_straight+38 to=@garden_straight+39 side=L every=100 offset=5 seed=60
PROPS kind=topiary from=@garden_straight+12 to=@fountain_corner side=both every=12 offset=3 seed=61
PROPS kind=topiary from=@greenhouse_walk to=@home+40 side=both every=14 offset=3 seed=62
PROPS kind=topiary from=@garden_terrace to=@orangery_sweeper side=both every=18 offset=3 seed=63
PROPS kind=tyre_wall from=@fountain_corner+1 to=@fountain_corner+41 side=R every=1.3 offset=0.6 seed=64
# final pass: the T1 chevrons are 1.5x and 0.2 m closer to the road, so the left-hander reads from the straight
PROPS kind=ad_board_b from=@fountain_corner+4 to=@fountain_corner+40 side=R every=10 offset=2.4 scale=1.5-1.5 seed=65
PROPS kind=flag_pole from=@garden_straight+52 to=@garden_straight+62 side=L every=5 offset=4 seed=66
# open garden by the fountain and the gate, and round the gazebo: ground cover and shrubs
PROPS kind=grass_tuft from=@fountain_corner to=@ballroom_entry side=both every=0.8 offset=0.2 jitter=8 scale=1.0-1.8 seed=70
PROPS kind=grass_tuft from=@gazebo_kink to=@home side=both every=0.8 offset=0.2 jitter=8 scale=1.0-1.8 seed=71
PROPS kind=flower_patch from=@fountain_corner to=@ballroom_entry side=both every=5 offset=0.8 jitter=9 scale=0.8-1.3 seed=72
PROPS kind=flower_patch from=@gazebo_kink to=@home side=both every=5 offset=0.8 jitter=9 scale=0.8-1.3 seed=73
PROPS kind=bush_round from=@fountain_corner to=@ballroom_entry side=both every=11 offset=3 jitter=9 scale=0.7-1.3 seed=74
PROPS kind=bush_round from=@garden_terrace to=@home side=both every=13 offset=5 jitter=8 scale=0.7-1.3 seed=75
PROPS kind=rock_cluster from=@garden_terrace to=@home side=both every=29 offset=6 jitter=10 scale=0.6-1.3 seed=76
PROPS kind=grass_tuft from=@garden_terrace to=@home side=both every=1.6 offset=3.2 jitter=8 scale=1.0-1.8 seed=77
# autumn trees behind the hedges and the far woods (none behind the stand or the grid)
PROPS kind=tree_round_big from=@garden_straight+60 to=@ballroom_entry side=both every=17 offset=13 jitter=12 scale=0.8-1.3 seed=80
PROPS kind=tree_round_big from=@garden_terrace to=@home side=both every=17 offset=13 jitter=14 scale=0.8-1.3 seed=81
PROPS kind=tree_round_big from=@garden_straight to=@garden_straight+60 side=R every=17 offset=13 jitter=12 scale=0.8-1.3 seed=82
PROPS kind=tree_clump from=@garden_straight to=@ballroom_entry side=both every=26 offset=60 jitter=50 scale=0.9-1.4 seed=83
PROPS kind=tree_clump from=@garden_terrace to=@home side=both every=26 offset=60 jitter=50 scale=0.9-1.4 seed=84
PROPS kind=tree_clump from=@garden_terrace to=@home side=both every=34 offset=125 jitter=50 scale=1.0-1.6 seed=85
PROPS kind=sky_lantern from=@garden_terrace to=@home side=both every=150 offset=45 jitter=50 seed=86
PROPS kind=sky_lantern from=@garden_straight to=@ballroom_entry side=R every=90 offset=50 jitter=40 seed=87
# the start zone (line ±10 m and the pads at 1763 exclude PROPS rows from 1757 to 10): hedges, lanterns and topiary
# hand-placed from the baked frame (offset from the road edge)
PROP kind=hedge at=(-40.0,-0.4,-6.9) yaw=270 scale=1
PROP kind=hedge at=(-40.0,-0.0,6.9) yaw=90 scale=1
PROP kind=hedge at=(-32.0,-0.2,-6.9) yaw=270 scale=1
PROP kind=hedge at=(-32.0,-0.2,6.9) yaw=90 scale=1
PROP kind=hedge at=(-16.0,-0.2,-6.9) yaw=270 scale=1
PROP kind=hedge at=(-16.0,-0.2,6.9) yaw=90 scale=1
PROP kind=hedge at=(-8.0,-0.2,6.9) yaw=90 scale=1
# (review round: a garden gate at the grid on the left, framed by the lantern posts and topiary at x = -12, so the
# standard 3/4 kart camera sees the grid instead of the back of a hedge)
PROP kind=hedge at=(0.0,-0.2,6.9) yaw=90 scale=1
PROP kind=hedge at=(8.0,-0.2,-6.9) yaw=270 scale=1
PROP kind=hedge at=(8.0,-0.2,6.9) yaw=90 scale=1
PROP kind=lantern_post at=(-28.0,-0.2,-8.5) yaw=270 scale=1
PROP kind=lantern_post at=(-28.0,-0.2,8.5) yaw=90 scale=1
PROP kind=lantern_post at=(-12.0,-0.2,-8.5) yaw=270 scale=1
PROP kind=lantern_post at=(-12.0,-0.2,8.5) yaw=90 scale=1
PROP kind=topiary at=(-36.0,-0.2,-9.5) yaw=270 scale=1
PROP kind=topiary at=(-36.0,-0.2,9.5) yaw=90 scale=1
PROP kind=topiary at=(-20.0,-0.2,-9.5) yaw=270 scale=1
PROP kind=topiary at=(-20.0,-0.2,9.5) yaw=90 scale=1
PROP kind=topiary at=(-12.0,-0.2,-10.5) yaw=270 scale=1
PROP kind=topiary at=(-12.0,-0.2,10.5) yaw=90 scale=1
THEME lantern_hollow sky=night mood=manor headlights=on scatter=tree_round_big,crooked_tree,crooked_tree,rose_bush,bush_round,topiary,gravestone,pumpkin_patch,rock_cluster,flower_patch density=30 hills=3 fogNear=90 fogFar=650
